+// NEGATIVE LOOKUP CACHE (emsdk.8.patch).
+//
+// Every miss in OPFSDirectory::getChild is a blocking round trip through the OPFS worker and the browser
+// (~260 us measured in ikvmcraft), where a kernel answers a repeated ENOENT from its negative dentry cache.
+// Code that canonicalizes paths through realpath() probes the same missing name once per path component
+// (JDK_Canonicalize retries every shorter prefix), so one missing directory can cost tens of thousands of
+// round trips: 82,189 of them for `/minecraft/file:` during one Minecraft resource reload, ~14 s of boot.
+//
+// So each directory remembers the names the browser reported NOT FOUND (-EEXIST from
+// wasmfsOPFSGetOrCreateFile/Dir; any other failure is not cached) and answers them locally.
+//
+// It is only as fresh as this process's view: a name created through wasmfs in that directory is dropped
+// from the set (insertDataFile/insertDirectory/insertMove), but an entry created BEHIND wasmfs's back --
+// JS calling the OPFS API directly, another tab or worker -- stays invisible until the cache is
+// invalidated. wasmfs_opfs_invalidate_negative_cache() bumps a global generation; each directory drops
+// its set the next time it is consulted under a different generation. It is a single atomic add, safe
+// from any thread including the main browser thread, and exported for JS as
+// Module._wasmfs_opfs_invalidate_negative_cache when the link exports it.
+//
+// Access to a directory's set happens inside getChild/insert*, which wasmfs calls with that directory's
+// lock held, so the set needs no lock of its own.
+static std::atomic<uint32_t> opfsNegGen{1};
+static std::atomic<uint64_t> opfsNegHits{0};       // lookups answered from a set
+static std::atomic<uint64_t> opfsNegInserts{0};    // misses recorded
+static std::atomic<uint64_t> opfsNegInvalidates{0};
+static std::atomic<uint64_t> opfsNegOverflows{0};  // sets cleared for exceeding OPFS_NEG_MAX
+#define OPFS_NEG_MAX 4096                          // names per directory before its set is dropped
+
+struct NegativeNames {
+  std::unordered_set<std::string> names;
+  uint32_t gen = 0;
+
+  void sync() {
+    uint32_t g = opfsNegGen.load(std::memory_order_acquire);
+    if (gen != g) {
+      names.clear();
+      gen = g;
+    }
+  }
+  bool has(const std::string& name) {
+    sync();
+    return names.count(name) != 0;
+  }
+  void add(const std::string& name) {
+    sync();
+    if (names.size() >= OPFS_NEG_MAX) {
+      names.clear();
+      opfsNegOverflows.fetch_add(1, std::memory_order_relaxed);
+    }
+    names.insert(name);
+    opfsNegInserts.fetch_add(1, std::memory_order_relaxed);
+  }
+  void drop(const std::string& name) { names.erase(name); }
+};
+
