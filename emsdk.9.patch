+/* Forget every name any OPFS directory has cached as missing (see NEGATIVE LOOKUP CACHE). Call it after creating
+ * OPFS entries without going through wasmfs -- JS using the OPFS API directly, another tab -- or they stay
+ * invisible to this process. One atomic add; safe from any thread, including the main browser thread. */
+EMSCRIPTEN_KEEPALIVE void wasmfs_opfs_invalidate_negative_cache(void) {
+  opfsNegGen.fetch_add(1, std::memory_order_acq_rel);
+  opfsNegInvalidates.fetch_add(1, std::memory_order_relaxed);
+}
+
+/* The negative cache's counters: 0 = lookups answered from it, 1 = misses recorded, 2 = invalidations,
+ * 3 = per-directory sets dropped for exceeding OPFS_NEG_MAX. */
+EMSCRIPTEN_KEEPALIVE double wasmfs_opfs_negative_stat(int what) {
+  switch (what) {
+    case 0: return (double)opfsNegHits.load(std::memory_order_relaxed);
+    case 1: return (double)opfsNegInserts.load(std::memory_order_relaxed);
+    case 2: return (double)opfsNegInvalidates.load(std::memory_order_relaxed);
+    case 3: return (double)opfsNegOverflows.load(std::memory_order_relaxed);
+    default: return 0;
+  }
+}
