 extern "C" {
 
+/*
+ * READ THE BLOCKED-TIME COUNTERS. One flat accessor rather than a struct, because the caller is JS reading
+ * through `Module._wasmfs_opfs_stat` and a struct would mean agreeing a memory layout across the boundary.
+ *
+ * `kind` is an OpfsOpKind, or -1 for the sum over all kinds -- so a caller can take the total without
+ * knowing how many kinds exist, which is what makes "do the parts sum to the whole" checkable from JS
+ * instead of being asserted in a comment.
+ *
+ * `field`: 0 = op count, 1 = total blocked NANOSECONDS, 2 = bytes moved, 3+k = count in latency bucket k.
+ *
+ * WHY THIS REPLACES THE err() PRINT. The OPFS_STATS line in library_wasmfs_opfs.js fires every 8192 reads,
+ * which has two consequences that invalidated a month of readings: the reported `reads` is always a
+ * multiple of 8192 and is a FLOOR (the "reads = 98304" in the note above is the twelfth checkpoint, not a
+ * total), and nothing at all is printed after the last read checkpoint -- so `writes` read 3-13 and `flush`
+ * read 0 for the entire project, which is an artefact of the trigger and NOT evidence that the write path
+ * is unused. A pull-based accessor has neither problem: the harness reads it at each phase boundary.
+ */
+EMSCRIPTEN_KEEPALIVE double wasmfs_opfs_stat(int kind, int field) {
+  auto one = [&](int k) -> double {
+    if (k < 0 || k >= OPFS_OP_KINDS) return 0;
+    if (field == 0) return (double)opfsOpCount[k].load(std::memory_order_relaxed);
+    if (field == 1) return (double)opfsOpNanos[k].load(std::memory_order_relaxed);
+    if (field == 2) return (double)opfsOpBytes[k].load(std::memory_order_relaxed);
+    int b = field - 3;
+    if (b >= 0 && b < OPFS_LAT_BUCKETS) return (double)opfsOpLat[k][b].load(std::memory_order_relaxed);
+    return 0;
+  };
+  if (kind >= 0) return one(kind);
+  double sum = 0;
+  for (int k = 0; k < OPFS_OP_KINDS; k++) sum += one(k);
+  return sum;
+}
+
+/* Shape of the table, so JS never hardcodes it: 0 = number of op kinds, 1 = number of latency buckets,
+ * 2+k = upper edge of bucket k in microseconds (the last bucket has no upper edge and reads 0). */
+EMSCRIPTEN_KEEPALIVE double wasmfs_opfs_stat_shape(int what) {
+  if (what == 0) return OPFS_OP_KINDS;
+  if (what == 1) return OPFS_LAT_BUCKETS;
+  int i = what - 2;
+  if (i >= 0 && i < (int)(sizeof(OPFS_LAT_EDGE_US) / sizeof(OPFS_LAT_EDGE_US[0]))) return OPFS_LAT_EDGE_US[i];
+  return 0;
+}
