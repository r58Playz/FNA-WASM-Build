+// BLOCKED-TIME ACCOUNTING
+//
+// The op COUNT has been instrumented since 2026-08 (see the read-ahead-cache note below) and it was never
+// converted into TIME. That left the central question about this backend unanswered for a month: ~100,000
+// blocking cross-thread round trips is either ~2.5 s of the run or ~300 s of it, and the two answers imply
+// opposite decisions. Counting is not measuring.
+//
+// So each `proxy(...)` below -- which BLOCKS the calling thread until the dedicated OPFS worker runs the op
+// and replies -- is wrapped in a timer, accumulated per op kind, plus a coarse latency histogram.
+//
+// WHY THE HISTOGRAM BUCKETS ARE WHERE THEY ARE. From OPFS_STATS checkpoint pacing over 280 archived runs
+// (2026-09-07) the floor is ~22 us and every run contains a stretch at ~3 ms. The 2 ms bucket boundary is
+// deliberate: 2 ms is the WasmFS proxy heartbeat interval (library_wasmfs.js), which is the FALLBACK
+// delivery path taken whenever the mailbox notification is late. So mass at or above the 2 ms bucket is
+// evidence that ops are waiting for the heartbeat rather than for the work, and that is a different fix
+// (delivery) from making each op cheaper (batching, caching). Nothing else here can separate those two.
+//
+// COST: one `emscripten_get_now()` pair and one relaxed atomic add per op, against an op that already
+// blocks on a futex round trip. Relaxed ordering because these are statistics -- no other state depends on
+// them, so there is nothing to order against, and this must not introduce a barrier into the FS path.
+//
+// RESOLUTION CAVEAT: `emscripten_get_now()` is `performance.now()`, which Chrome coarsens to 5 us in a
+// cross-origin-isolated context (this app is, it needs SharedArrayBuffer). So a single sub-5-us reading is
+// not meaningful; the totals over ~100,000 ops are, and the bucket boundaries are all well above it.
+enum OpfsOpKind {
+  OPFS_OP_READ = 0,
+  OPFS_OP_WRITE,
+  OPFS_OP_GETSIZE,
+  OPFS_OP_SETSIZE,
+  OPFS_OP_FLUSH,
+  OPFS_OP_OPEN,
+  OPFS_OP_CLOSE,
+  OPFS_OP_DIR,
+  OPFS_OP_KINDS
+};
+// Upper edges in microseconds; the last bucket is everything above the previous edge.
+static const double OPFS_LAT_EDGE_US[] = {25.0, 100.0, 500.0, 2000.0, 8000.0};
+#define OPFS_LAT_BUCKETS 6
+
+static std::atomic<uint64_t> opfsOpCount[OPFS_OP_KINDS];
+static std::atomic<uint64_t> opfsOpNanos[OPFS_OP_KINDS];
+static std::atomic<uint64_t> opfsOpBytes[OPFS_OP_KINDS];
+static std::atomic<uint64_t> opfsOpLat[OPFS_OP_KINDS][OPFS_LAT_BUCKETS];
+
+// RAII so an early `return` inside a switch arm cannot skip the accounting -- several of the paths below
+// return straight out of the middle of an op.
+struct OpfsTimer {
+  OpfsOpKind kind;
+  double t0;
+  uint64_t bytes;
+  explicit OpfsTimer(OpfsOpKind k, uint64_t b = 0)
+    : kind(k), t0(emscripten_get_now()), bytes(b) {}
+  ~OpfsTimer() {
+    double us = (emscripten_get_now() - t0) * 1000.0;
+    if (us < 0) us = 0;
+    opfsOpCount[kind].fetch_add(1, std::memory_order_relaxed);
+    opfsOpNanos[kind].fetch_add((uint64_t)(us * 1000.0), std::memory_order_relaxed);
+    if (bytes) opfsOpBytes[kind].fetch_add(bytes, std::memory_order_relaxed);
+    int b = OPFS_LAT_BUCKETS - 1;
+    for (int i = 0; i < OPFS_LAT_BUCKETS - 1; i++) {
+      if (us < OPFS_LAT_EDGE_US[i]) { b = i; break; }
+    }
+    opfsOpLat[kind][b].fetch_add(1, std::memory_order_relaxed);
+  }
+};
