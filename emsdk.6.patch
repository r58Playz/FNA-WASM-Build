Subject: [PATCH] [wasmfs] fetch backend: getSize from a HEAD request, not a full download

A stat() on a fetch-backed file downloaded the whole file and kept it in wasmFS$JSMemoryFiles forever.
ikvmcraft: IKVM stats /dlls/<name>.dll (java.io.File.toURI -> isDirectory) when getPackage() first runs on an
ikvmc assembly, which fetched and retained ikvmc_lwjgl3 (82.8 MB), jvmdowngrader and log4j (5.5 MB each) at boot.
getSize now uses Content-Length from a HEAD request (only without Content-Encoding) and caches it; a read
still fetches the file. Anything else falls back to the old full fetch.

Ported to emscripten 6.0.2 (fna-6.0.2 c3ba013); paths are emscripten 6's src/lib/lib*.js.

diff --git a/src/lib/libwasmfs_fetch.js b/src/lib/libwasmfs_fetch.js
index 477a8eb..d9fe38f 100644
--- a/src/lib/libwasmfs_fetch.js
+++ b/src/lib/libwasmfs_fetch.js
@@ -6,6 +6,8 @@
 
 addToLibrary({
   $wasmFS$JSMemoryRanges: {},
+  // Sizes answered from a HEAD before any data was fetched (getSize below).
+  $wasmFS$fetchSizes: {},
 
   // Fetch backend: On first access of the file (either a read or a getSize), it
   // will fetch() the data from the network asynchronously. Otherwise, after
@@ -14,27 +16,29 @@ addToLibrary({
   _wasmfs_create_fetch_backend_js__deps: [
     '$wasmFS$backends',
     '$wasmFS$JSMemoryRanges',
+    '$wasmFS$fetchSizes',
     '_wasmfs_fetch_get_file_url',
     '_wasmfs_fetch_get_chunk_size',
   ],
   _wasmfs_create_fetch_backend_js: async function(backend) {
     // Get a promise that fetches the data and stores it in JS memory (if it has
     // not already been fetched).
-    async function getFileRange(file, offset, len) {
-      var url = '';
+    function getFileUrl(file) {
       var fileUrl_p = __wasmfs_fetch_get_file_url(file);
       var fileUrl = UTF8ToString(fileUrl_p);
       var isAbs = fileUrl.indexOf('://') !== -1;
       if (isAbs) {
-        url = fileUrl;
-      } else {
-        try {
-          var u = new URL(fileUrl, self.location.origin);
-          url = u.toString();
-        } catch (_e) {
-          throw {status: 404};
-        }
+        return fileUrl;
       }
+      try {
+        var u = new URL(fileUrl, self.location.origin);
+        return u.toString();
+      } catch (_e) {
+        throw {status: 404};
+      }
+    }
+    async function getFileRange(file, offset, len) {
+      var url = getFileUrl(file);
       var chunkSize = __wasmfs_fetch_get_chunk_size(file);
       offset ??= 0;
       len ??= chunkSize;
@@ -114,6 +118,7 @@ addToLibrary({
       freeFile: async (file) => {
         // free memory
         wasmFS$JSMemoryRanges[file] = undefined;
+        delete wasmFS$fetchSizes[file];
       },
 
       write: async (file, buffer, length, offset) => {
@@ -156,6 +161,28 @@ addToLibrary({
         return readLength;
       },
       getSize: async (file) => {
+        // Until the file's data is wanted, answer from a HEAD's Content-Length: getFileRange downloads (and
+        // keeps) the WHOLE file when the server offers no byte ranges or the file is under two chunks, which
+        // would make every stat() of such a file a full download. (FNA-WASM-Build emsdk.6.)
+        if (!wasmFS$JSMemoryRanges[file]) {
+          var known = wasmFS$fetchSizes[file];
+          if (known !== undefined) {
+            return known;
+          }
+          try {
+            var head = await fetch(getFileUrl(file), {method: 'HEAD'});
+            var len = head.headers.get('Content-Length');
+            if (head.ok && len !== null && !head.headers.get('Content-Encoding')) {
+              var n = Number(len);
+              if (Number.isSafeInteger(n) && n >= 0) {
+                wasmFS$fetchSizes[file] = n;
+                return n;
+              }
+            }
+          } catch (e) {
+            // fall through to the fetching path, which reports the failure
+          }
+        }
         try {
           await getFileRange(file, 0, 0);
         } catch (failedResponse) {
