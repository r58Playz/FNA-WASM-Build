                        int newdirfd,
                        const char* newpath) {
-  // Rename is the only syscall that needs to (or is allowed to) acquire locks
-  // on two directories at once. It requires locks on both the old and new
+  // Rename is the only syscall that holds two directory locks that are not
+  // parent and child (see the lock order below). It requires locks on both the old and new
   // parent directories to ensure that the moved file can be atomically removed
   // from the old directory and added to the new directory without something
   // changing that would prevent the move.
@@ -1075,7 +1082,42 @@
     return -ENAMETOOLONG;
   }
 
-  // Lock both directories.
+  auto root = wasmFS.getRootDirectory();
+
+  // Lock order. Everywhere else a directory is locked before its child:
+  // Directory::Handle::getChild holds the parent while cacheChild locks the
+  // child it caches, and unlink/rmdir hold the parent while locking the
+  // directory they remove. Walking newParent's ancestors while holding both
+  // parents, or locking oldParent before a newParent that is its ancestor,
+  // takes the reverse order and deadlocks against such a lookup (a game's
+  // save-time replace-by-rename in its world directory against another
+  // thread's path walk through that directory's parent). So collect both
+  // ancestor chains first, holding one directory lock at a time, and lock
+  // whichever parent is the other's ancestor first. renameMutex keeps the
+  // chains valid: only a rename gives a directory a different parent;
+  // unlink/rmdir clear it, and a cleared parent ends the walk.
+  auto ancestors = [&](std::shared_ptr<Directory> dir) {
+    std::vector<std::shared_ptr<Directory>> chain;
+    for (auto curr = dir; curr && curr != root;
+         curr = curr->locked().getParent()) {
+      chain.push_back(curr);
+    }
+    return chain;
+  };
+  auto newAncestors = ancestors(newParent);
+  auto oldAncestors = ancestors(oldParent);
+  // The root is in no chain and is every directory's ancestor.
+  bool newParentFirst =
+    newParent != oldParent &&
+    (newParent == root ||
+     std::find(oldAncestors.begin(), oldAncestors.end(), newParent) !=
+       oldAncestors.end());
+  std::optional<Directory::Handle> ancestorFirst;
+  if (newParentFirst) {
+    ancestorFirst.emplace(newParent->locked());
+  }
+
+  // Lock both directories (recursive: newParent may already be held above).
   auto lockedOldParent = oldParent->locked();
   auto lockedNewParent = newParent->locked();
 
@@ -1093,7 +1135,6 @@
