+// FNA-WASM-Build emsdk.13.patch, kept in the binary so a deploy can prove it is
+// served (the fix itself adds no string).
+__attribute__((used)) static const char wasmfs_rename_order_marker[] =
+  "emsdk13-wasmfs-rename-lockorder";
 #include "wasmfs.h"
 
 // File permission macros for wasmfs.
@@ -1044,8 +1051,8 @@
