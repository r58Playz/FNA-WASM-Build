diff --git a/system/lib/wasmfs/stream_file.cpp b/system/lib/wasmfs/stream_file.cpp
new file mode 100644
index 0000000..5b44c15
--- /dev/null
+++ b/system/lib/wasmfs/stream_file.cpp
@@ -0,0 +1,320 @@
+// Copyright 2026 The Emscripten Authors.  All rights reserved.
+// Emscripten is available under two separate licenses, the MIT license and the
+// University of Illinois/NCSA Open Source License.  Both these licenses can be
+// found in the LICENSE file.
+
+// The parts of stream files every kind shares: listener lists, blocking with
+// interruption, and the byte ring. See stream_file.h.
+
+#include "stream_file.h"
+#include "file_table.h"
+#include "wasmfs.h"
+
+#include <algorithm>
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+#include <errno.h>
+#include <limits.h>
+#include <math.h>
+#include <pthread.h>
+#include <string.h>
+
+extern "C" {
+// libc's raise.c: how many signal handlers raise() has run on this thread;
+// with `interrupting_only`, just those installed without SA_RESTART.
+unsigned int _emscripten_signals_handled(int interrupting_only);
+}
+
+namespace wasmfs {
+
+// ByteRing
+
+void ByteRing::reserve(size_t need) {
+  size_t cap = buf.size();
+  if (need <= cap) {
+    return;
+  }
+  size_t newCap = cap ? cap : 4096;
+  while (newCap < need) {
+    newCap *= 2;
+  }
+  std::vector<uint8_t> next(newCap);
+  peek(next.data(), count);
+  buf.swap(next);
+  head = 0;
+}
+
+void ByteRing::clear() {
+  head = count = 0;
+  std::vector<uint8_t>().swap(buf);
+}
+
+void ByteRing::push(const uint8_t* data, size_t len) {
+  if (!len) {
+    return;
+  }
+  reserve(count + len);
+  size_t mask = buf.size() - 1;
+  size_t tail = (head + count) & mask;
+  size_t first = std::min(len, buf.size() - tail);
+  memcpy(&buf[tail], data, first);
+  memcpy(&buf[0], data + first, len - first);
+  count += len;
+}
+
+size_t ByteRing::peek(uint8_t* out, size_t len, size_t skip) const {
+  if (skip >= count) {
+    return 0;
+  }
+  len = std::min(len, count - skip);
+  if (!len) {
+    return 0;
+  }
+  size_t start = (head + skip) & (buf.size() - 1);
+  size_t first = std::min(len, buf.size() - start);
+  memcpy(out, &buf[start], first);
+  memcpy(out + first, &buf[0], len - first);
+  return len;
+}
+
+void ByteRing::discard(size_t len) {
+  len = std::min(len, count);
+  if (!len) {
+    return;
+  }
+  head = (head + len) & (buf.size() - 1);
+  count -= len;
+  if (!count) {
+    head = 0;
+    // Give back what a burst grew, but keep a small ring for the next one.
+    if (buf.size() > 65536) {
+      std::vector<uint8_t>().swap(buf);
+    }
+  }
+}
+
+size_t
+ByteRing::readv(const iovec* iov, int iovcnt, size_t skip, bool peekOnly) {
+  size_t done = 0;
+  for (int i = 0; i < iovcnt && done < count; i++) {
+    size_t len = iov[i].iov_len;
+    if (skip >= len) {
+      skip -= len;
+      continue;
+    }
+    done += peek((uint8_t*)iov[i].iov_base + skip, len - skip, done);
+    skip = 0;
+  }
+  if (!peekOnly) {
+    discard(done);
+  }
+  return done;
+}
+
+size_t
+ByteRing::writev(const iovec* iov, int iovcnt, size_t skip, size_t limit) {
+  size_t done = 0;
+  for (int i = 0; i < iovcnt && done < limit; i++) {
+    size_t len = iov[i].iov_len;
+    if (skip >= len) {
+      skip -= len;
+      continue;
+    }
+    size_t n = std::min(len - skip, limit - done);
+    push((const uint8_t*)iov[i].iov_base + skip, n);
+    skip = 0;
+    done += n;
+  }
+  return done;
+}
+
+ssize_t iovecLength(const iovec* iov, int iovcnt) {
+  if (iovcnt < 0 || iovcnt > IOV_MAX) {
+    return -EINVAL;
+  }
+  size_t total = 0;
+  for (int i = 0; i < iovcnt; i++) {
+    if (!iov[i].iov_base && iov[i].iov_len) {
+      return -EFAULT;
+    }
+    if (iov[i].iov_len > SSIZE_MAX - total) {
+      return -EINVAL;
+    }
+    total += iov[i].iov_len;
+  }
+  return total;
+}
+
+// StreamFile
+
+void StreamFile::addListener(Listener* listener) {
+  std::lock_guard<std::mutex> lock(listenersMutex);
+  listener->prev = last;
+  listener->next = nullptr;
+  if (last) {
+    last->next = listener;
+  } else {
+    first = listener;
+  }
+  last = listener;
+}
+
+void StreamFile::removeListener(Listener* listener) {
+  std::lock_guard<std::mutex> lock(listenersMutex);
+  if (listener->prev) {
+    listener->prev->next = listener->next;
+  } else if (first == listener) {
+    first = listener->next;
+  } else {
+    // Not registered here.
+    return;
+  }
+  if (listener->next) {
+    listener->next->prev = listener->prev;
+  } else {
+    last = listener->prev;
+  }
+  listener->prev = listener->next = nullptr;
+}
+
+void StreamFile::notify(uint32_t events) {
+  constexpr uint32_t always = EPOLLERR | EPOLLHUP | StreamClosedEvent;
+  std::lock_guard<std::mutex> lock(listenersMutex);
+  bool exclusiveTaken = false;
+  for (Listener* l = first; l;) {
+    Listener* next = l->next;
+    if (events & (l->interest | always)) {
+      if (!l->exclusive || (events & StreamClosedEvent)) {
+        l->notify(events);
+      } else if (!exclusiveTaken && l->notify(events)) {
+        exclusiveTaken = true;
+        // Rotate it to the back so the next notification wakes another.
+        if (l != last) {
+          if (l->prev) {
+            l->prev->next = l->next;
+          } else {
+            first = l->next;
+          }
+          l->next->prev = l->prev;
+          l->prev = last;
+          l->next = nullptr;
+          last->next = l;
+          last = l;
+        }
+      }
+    }
+    l = next;
+  }
+}
+
+void StreamFile::closeAndNotify() {
+  closed.store(true);
+  notify(StreamClosedEvent | AllEvents);
+}
+
+ssize_t StreamFile::read(uint8_t* buf, size_t len, off_t offset) {
+  iovec iov = {buf, len};
+  return readv(&iov, 1, MSG_DONTWAIT);
+}
+
+ssize_t StreamFile::write(const uint8_t* buf, size_t len, off_t offset) {
+  iovec iov = {(void*)buf, len};
+  return writev(&iov, 1, MSG_DONTWAIT);
+}
+
+int addStreamDescriptor(std::shared_ptr<StreamFile> file, oflags_t flags) {
+  std::shared_ptr<OpenFileState> openFile;
+  if (int err = OpenFileState::create(file, flags, openFile)) {
+    return err;
+  }
+  int fd = wasmFS.getFileTable().locked().addEntry(openFile);
+  if (fd < 0) {
+    // The table is full. Undo the open() OpenFileState::create did.
+    (void)file->locked().close();
+    return -EMFILE;
+  }
+  return fd;
+}
+
+// Blocking
+
+void Wakeup::signal() {
+  word.store(1);
+#ifdef __EMSCRIPTEN_PTHREADS__
+  emscripten_futex_wake(&word, 1);
+#endif
+}
+
+class Blocker::Node : public Listener {
+public:
+  std::shared_ptr<StreamFile> file;
+  Wakeup* wakeup;
+
+  bool notify(uint32_t events) override {
+    wakeup->signal();
+    return true;
+  }
+};
+
+Blocker::Blocker(int timeoutMs, Kind kind)
+  : deadline(timeoutMs < 0 ? INFINITY : emscripten_get_now() + timeoutMs),
+    signalsAtStart(_emscripten_signals_handled(kind == Restartable)),
+    interruptingOnly(kind == Restartable) {}
+
+Blocker::~Blocker() {
+  for (auto& node : nodes) {
+    node->file->removeListener(node.get());
+  }
+}
+
+void Blocker::watch(std::shared_ptr<StreamFile> file, uint32_t events) {
+  auto node = std::make_unique<Node>();
+  node->file = std::move(file);
+  node->wakeup = &wakeup;
+  node->interest = events;
+  node->file->addListener(node.get());
+  nodes.push_back(std::move(node));
+}
+
+int Blocker::wait() {
+#ifdef __EMSCRIPTEN_PTHREADS__
+  // Run what pthread_kill() proxied to this thread: that is where signal
+  // handlers run.
+  emscripten_current_thread_process_queued_calls();
+  if (_emscripten_signals_handled(interruptingOnly) != signalsAtStart) {
+    return -EINTR;
+  }
+  double timeout = INFINITY;
+  if (deadline != INFINITY) {
+    timeout = deadline - emscripten_get_now();
+    if (timeout <= 0) {
+      return -ETIMEDOUT;
+    }
+  }
+  // Nothing on this path may be unwound by a cancellation: the listeners
+  // registered on other files point into this frame.
+  int cancelState;
+  pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cancelState);
+  // Any return (woken, timed out, or -EINTR when pthread_kill or another
+  // proxied call pokes this thread) goes back to the caller's re-check; the
+  // next wait() sees a signal or a passed deadline.
+  emscripten_futex_wait(&wakeup.word, 0, timeout);
+  pthread_setcancelstate(cancelState, nullptr);
+  return 0;
+#else
+  // canBlock() is false without pthreads; nothing waits.
+  return -ETIMEDOUT;
+#endif
+}
+
+bool Blocker::canBlock() {
+#ifdef __EMSCRIPTEN_PTHREADS__
+  // The main browser thread cannot Atomics.wait (emscripten would spin it),
+  // and must not stall on a peer anyway.
+  return !emscripten_is_main_browser_thread();
+#else
+  return false;
+#endif
+}
+
+} // namespace wasmfs
diff --git a/system/lib/wasmfs/stream_file.h b/system/lib/wasmfs/stream_file.h
new file mode 100644
index 0000000..0544051
--- /dev/null
+++ b/system/lib/wasmfs/stream_file.h
@@ -0,0 +1,276 @@
+// Copyright 2026 The Emscripten Authors.  All rights reserved.
+// Emscripten is available under two separate licenses, the MIT license and the
+// University of Illinois/NCSA Open Source License.  Both these licenses can be
+// found in the LICENSE file.
+
+// Stream files: pipes, sockets, eventfds and epoll instances.
+//
+// A StreamFile is read, written and polled by the syscall layer without the
+// File lock or the OpenFileState lock held, so a read can block while another
+// thread writes to the same file, polls it or closes it. Each stream file keeps
+// its own state lock and a list of Listeners (threads blocked in it, and epoll
+// registrations) that it notifies when its readiness may have changed.
+//
+// Lock order (a thread holding one of these may only take ones further down):
+//   1. FileTable lock, then OpenFileState lock: held only to find a file.
+//   2. File lock (file.h): close(), fstat and ioctl hold it around a stream
+//      file's close() and getSize().
+//   3. EpollFile::mutex: an epoll instance's interest set. An epoll that
+//      watches another takes its own before the watched one's; nesting is
+//      acyclic (epoll_ctl refuses loops with ELOOP).
+//   4. A stream file's state lock (its buffers and flags).
+//   5. StreamFile::listenersMutex. A notification runs the listeners with it
+//      held, and an epoll registration then notifies its epoll's own
+//      listeners: a watched file's lock before its watcher's.
+//   6. EpollFile::readyMutex: the ready list.
+// Nothing blocks or calls JS while holding any of them, and a stream file's
+// readv/writev/poll run with none of 1-2 held.
+//
+// Stream files are not reachable by path, so each has exactly one
+// OpenFileState, and close() runs exactly when its last descriptor goes away.
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <poll.h>
+#include <stdint.h>
+#include <sys/epoll.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <vector>
+
+#include "file.h"
+
+namespace wasmfs {
+
+class EpollFile;
+class SocketFile;
+
+// Readiness is reported in EPOLL* bits. musl gives the POLL* bits the same
+// values (EPOLLIN == POLLIN, EPOLLRDHUP == POLLRDHUP, ...).
+//
+// Only passed to notify(): the file's last descriptor closed. Every listener
+// hears it, whatever its interest.
+constexpr uint32_t StreamClosedEvent = POLLNVAL;
+
+// Readiness masks producers pass to notify().
+constexpr uint32_t ReadableEvents = EPOLLIN | EPOLLRDNORM;
+constexpr uint32_t WritableEvents = EPOLLOUT | EPOLLWRNORM;
+constexpr uint32_t AllEvents = ReadableEvents | WritableEvents | EPOLLRDHUP |
+                               EPOLLHUP | EPOLLERR;
+
+// Something that wants to hear when a StreamFile's readiness may have changed.
+class Listener {
+public:
+  virtual ~Listener() = default;
+
+  // Runs with the notifying file's listener lock held: it must not block, and
+  // may only take locks that order after it (see the lock order above).
+  // Returns whether the event was taken, which only matters for exclusive
+  // listeners.
+  virtual bool notify(uint32_t events) = 0;
+
+  // The events to deliver; EPOLLERR, EPOLLHUP and StreamClosedEvent always
+  // are. Fixed while the listener is registered.
+  uint32_t interest = 0;
+
+  // EPOLLEXCLUSIVE: of a file's exclusive listeners, each notification goes
+  // to the first one that takes it, which then moves to the back of the list.
+  bool exclusive = false;
+
+private:
+  friend class StreamFile;
+  Listener* prev = nullptr;
+  Listener* next = nullptr;
+};
+
+// A FIFO of bytes in a power-of-two ring that grows as needed. Not
+// thread-safe: owners guard it with their state lock.
+class ByteRing {
+  std::vector<uint8_t> buf;
+  size_t head = 0;
+  size_t count = 0;
+
+  void reserve(size_t need);
+
+public:
+  size_t size() const { return count; }
+  bool empty() const { return count == 0; }
+  void clear();
+  void push(const uint8_t* data, size_t len);
+  // Copies up to `len` bytes starting `skip` bytes in, without consuming.
+  size_t peek(uint8_t* out, size_t len, size_t skip = 0) const;
+  void discard(size_t len);
+  size_t pop(uint8_t* out, size_t len) {
+    size_t n = peek(out, len);
+    discard(n);
+    return n;
+  }
+  // Fills the iovecs, after skipping their first `skip` bytes, from the front
+  // of the ring; consumes unless `peek`.
+  size_t readv(const iovec* iov, int iovcnt, size_t skip, bool peek);
+  // Appends at most `limit` bytes taken from the iovecs after skipping the
+  // first `skip` bytes of them.
+  size_t writev(const iovec* iov, int iovcnt, size_t skip, size_t limit);
+};
+
+// The total length of the iovecs, or a negative errno.
+ssize_t iovecLength(const iovec* iov, int iovcnt);
+
+class StreamFile : public DataFile {
+public:
+  StreamFile(mode_t mode, mode_t fileType)
+    : DataFile(mode, NullBackend, fileType) {
+    seekable = false;
+  }
+
+  StreamFile* asStream() override { return this; }
+  virtual SocketFile* asSocket() { return nullptr; }
+  virtual EpollFile* asEpoll() { return nullptr; }
+
+  // The readiness of this end now, in EPOLL* bits (a pipe's read end never
+  // reports EPOLLOUT). Called with no lock held, or from an epoll instance
+  // holding its own mutex.
+  virtual uint32_t poll() = 0;
+
+  // Scatter read and gather write. `flags` are MSG_* bits; the syscall layer
+  // adds MSG_DONTWAIT for O_NONBLOCK descriptors. They return a byte count or
+  // a negative errno and block (see Blocker) unless MSG_DONTWAIT is set.
+  virtual ssize_t readv(const iovec* iov, int iovcnt, int flags) = 0;
+  virtual ssize_t writev(const iovec* iov, int iovcnt, int flags) = 0;
+
+  // True once close() ran. A blocked reader or writer then fails with EBADF.
+  bool isClosed() const { return closed.load(); }
+
+  void addListener(Listener* listener);
+  void removeListener(Listener* listener);
+
+  // Tells the listeners interested in `events` that this file may be ready.
+  // Producers call it after the state change; with or without their state
+  // lock held.
+  void notify(uint32_t events);
+
+  std::shared_ptr<StreamFile> sharedStream() {
+    return std::static_pointer_cast<StreamFile>(shared_from_this());
+  }
+
+protected:
+  // For close(): marks the file closed and wakes every listener.
+  void closeAndNotify();
+
+  // The DataFile interface, for callers that bypass the stream path. Never
+  // blocks.
+  ssize_t read(uint8_t* buf, size_t len, off_t offset) override;
+  ssize_t write(const uint8_t* buf, size_t len, off_t offset) override;
+  int setSize(off_t size) override { return -EINVAL; }
+  int flush() override { return 0; }
+
+private:
+  std::atomic<bool> closed{false};
+  std::mutex listenersMutex;
+  Listener* first = nullptr;
+  Listener* last = nullptr;
+};
+
+// A word a blocked thread sleeps on.
+struct Wakeup {
+  std::atomic<uint32_t> word{0};
+  void signal();
+};
+
+// Blocks the calling thread in a stream syscall until a watched file notifies
+// it, a timeout passes, or a signal handler runs on the thread:
+//
+//   Blocker blocker(timeoutMs, Blocker::Restartable);
+//   blocker.watch(file, EPOLLIN);
+//   while (true) {
+//     blocker.arm();
+//     if (<condition holds>) break;
+//     if (int err = blocker.wait()) return err;  // -EINTR or -ETIMEDOUT
+//   }
+//
+// arm() comes before the condition check so a notification between the check
+// and the sleep is not lost. The caller holds no WasmFS lock across wait().
+//
+// Signals: pthread_kill() proxies raise() to the target's system queue and
+// wakes it (pthread_kill.c). wait() runs that queue, and fails with -EINTR if
+// a handler has run on this thread since the Blocker was made (libc counts
+// them in raise.c). A Restartable syscall (read, write, connect: the ones
+// Linux restarts under SA_RESTART) only counts handlers without SA_RESTART;
+// an Interruptible one (poll, epoll_wait) counts every handler. Handlers must
+// return normally. Blocked stream I/O is not a pthread cancellation point.
+//
+// The main browser thread cannot block (it cannot Atomics.wait); there, and
+// in builds without pthreads, every descriptor behaves as if O_NONBLOCK were
+// set and timeouts are zero. See canBlock().
+class Blocker {
+public:
+  enum Kind { Restartable, Interruptible };
+
+  // timeoutMs < 0 waits indefinitely.
+  Blocker(int timeoutMs, Kind kind);
+  ~Blocker();
+  Blocker(const Blocker&) = delete;
+  Blocker& operator=(const Blocker&) = delete;
+
+  // Registers for notifications from `file` until the Blocker goes away.
+  void watch(std::shared_ptr<StreamFile> file, uint32_t events);
+
+  void arm() { wakeup.word.store(0); }
+
+  // Sleeps until notified. Returns 0 to re-check the condition, -EINTR, or
+  // -ETIMEDOUT once the deadline has passed.
+  int wait();
+
+  // Whether this thread may block at all.
+  static bool canBlock();
+
+private:
+  class Node;
+  Wakeup wakeup;
+  std::vector<std::unique_ptr<Node>> nodes;
+  // Unused without pthreads, where nothing blocks.
+  [[maybe_unused]] double deadline;
+  [[maybe_unused]] unsigned int signalsAtStart;
+  [[maybe_unused]] bool interruptingOnly;
+};
+
+// Opens `file` with these flags (O_RDONLY etc., O_NONBLOCK) and gives it the
+// lowest free descriptor. Returns the descriptor or a negative errno.
+int addStreamDescriptor(std::shared_ptr<StreamFile> file, oflags_t flags);
+
+// Runs attempt() until it returns something other than -EAGAIN, blocking on
+// `file` for `events` in between unless `flags` has MSG_DONTWAIT or this
+// thread cannot block. A timeout ends it with -EAGAIN.
+template<typename Attempt>
+ssize_t blockUntil(StreamFile* file,
+                   uint32_t events,
+                   int flags,
+                   int timeoutMs,
+                   Blocker::Kind kind,
+                   Attempt attempt) {
+  ssize_t result = attempt();
+  if (result != -EAGAIN || (flags & MSG_DONTWAIT) || !Blocker::canBlock()) {
+    return result;
+  }
+  Blocker blocker(timeoutMs, kind);
+  blocker.watch(file->sharedStream(), events);
+  while (true) {
+    blocker.arm();
+    result = attempt();
+    if (result != -EAGAIN) {
+      return result;
+    }
+    int err = blocker.wait();
+    if (err == -ETIMEDOUT) {
+      return -EAGAIN;
+    }
+    if (err) {
+      return err;
+    }
+  }
+}
+
+} // namespace wasmfs
