--- /dev/null
+++ b/system/lib/wasmfs/inet_socket.cpp
@@ -0,0 +1,889 @@
+// Copyright 2026 The Emscripten Authors.  All rights reserved.
+// Emscripten is available under two separate licenses, the MIT license and the
+// University of Illinois/NCSA Open Source License.  Both these licenses can be
+// found in the LICENSE file.
+
+// AF_INET and AF_INET6 sockets over a transport the embedder supplies in JS
+// (src/lib/libwasmfs_sockets.js documents the interface).
+//
+// SOCK_STREAM sockets connect out; there is no listen() or accept().
+// SOCK_DGRAM sockets exist so that code probing for them works, but every send
+// fails with ENETUNREACH and nothing is ever received.
+//
+// One dedicated network pthread owns the transport: syscalls post connect,
+// send, shutdown and close to it (emscripten_proxy_async) and never wait on
+// it; the transport's events arrive on it and call back into the
+// wasmfs_socket_on_* functions below, which update the socket and notify its
+// listeners. The main browser thread is never involved. Without pthreads the
+// transport runs inline on the calling thread.
+//
+// A socket's sends queue in its send ring until the network thread hands them
+// to the transport; they then count as in flight until the transport reports
+// them drained. Ring plus in-flight bytes are bounded by SO_SNDBUF: past it a
+// write blocks (or fails with EAGAIN) and EPOLLOUT clears. Received bytes go
+// into the receive ring; when it holds SO_RCVBUF bytes the transport is asked
+// to pause, and to resume once a reader drains it to half that. A transport
+// without pause() makes the ring grow without bound.
+
+#include <algorithm>
+#include <arpa/inet.h>
+#include <emscripten/console.h>
+#include <emscripten/emscripten.h>
+#include <emscripten/proxying.h>
+#include <emscripten/syscalls.h>
+#include <emscripten/threading.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <functional>
+#include <netinet/in.h>
+#include <pthread.h>
+#include <string.h>
+#include <string>
+#include <unordered_map>
+
+#include "resolver.h"
+#include "socket_file.h"
