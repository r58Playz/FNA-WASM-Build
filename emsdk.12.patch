+// How many handlers raise() has run on this thread: all of them, and those
+// installed without SA_RESTART. A blocking WasmFS syscall compares them across
+// its wait to tell a signal (EINTR) from another wake-up; only the second
+// interrupts a syscall Linux restarts under SA_RESTART (read, write, connect).
+static _Thread_local unsigned int handled_all, handled_interrupting;
+
