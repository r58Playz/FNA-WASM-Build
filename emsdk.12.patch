+namespace wasmfs {
+
+namespace {
+
+// Linux's usual initial window and a receive bound that rides out a burst.
+constexpr size_t DefaultSendBuffer = 256 * 1024;
+constexpr size_t DefaultRecvBuffer = 1024 * 1024;
+
+// The local address getsockname() reports once connected: a NAT-style one.
+constexpr uint32_t FakeLocalV4 = 0x0A00020F; // 10.0.2.15
+
+std::atomic<uint32_t> nextSocketId{1};
+std::atomic<uint32_t> nextEphemeral{0};
+
+uint16_t ephemeralPort() {
+  // Linux's default ip_local_port_range, 32768-60999.
+  return 32768 + nextEphemeral.fetch_add(1) % 28232;
+}
+
+class NetworkThread {
+public:
+  // Runs `task` on the network thread, in order with the other tasks.
+  static void post(std::function<void()>&& task);
+
+private:
+#ifdef __EMSCRIPTEN_PTHREADS__
+  emscripten::ProxyingQueue queue;
+  pthread_t thread;
+  bool started = false;
+
+  NetworkThread() {
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    started = pthread_create(&thread, &attr, run, this) == 0;
+    pthread_attr_destroy(&attr);
+  }
+
+  static void* run(void* arg) {
+    auto* self = (NetworkThread*)arg;
+    _wasmfs_socket_thread_init(self->queue.queue);
+    // Sit in the event loop: proxied tasks and transport events run there.
+    emscripten_exit_with_live_runtime();
+  }
+#endif
+};
+
+void NetworkThread::post(std::function<void()>&& task) {
+#ifdef __EMSCRIPTEN_PTHREADS__
+  // Started on first use (the first connect), never destroyed. Callers hold no
+  // lock: from a worker, pthread_create waits for the main thread.
+  static NetworkThread* instance = new NetworkThread();
+  if (instance->started) {
+    if (pthread_equal(pthread_self(), instance->thread)) {
+      task();
+    } else if (!instance->queue.proxyAsync(instance->thread,
+                                           std::move(task))) {
+      emscripten_err("wasmfs: could not post to the network thread");
+    }
+    return;
+  }
+  // No thread could be started: run the transport here.
+#endif
+  task();
+}
+
+// Where a connect() goes, as the transport sees it.
+struct Target {
+  std::string host;
+  uint16_t port = 0;
+  // 4 or 6 for an address literal, 0 for a hostname.
+  int family = 0;
+};
+
+class InetSocket;
+
+std::mutex registryMutex;
+// Sockets the transport knows, by id. Ids are never reused, so a late event
+// for a closed socket finds nothing.
+std::unordered_map<uint32_t, std::shared_ptr<InetSocket>> registry;
+
+std::shared_ptr<InetSocket> findSocket(uint32_t id) {
+  std::lock_guard<std::mutex> lock(registryMutex);
+  auto it = registry.find(id);
+  return it == registry.end() ? nullptr : it->second;
+}
+
+bool unmapV4(const in6_addr& a6, in_addr& a4) {
+  if (!IN6_IS_ADDR_V4MAPPED(&a6)) {
+    return false;
+  }
+  memcpy(&a4, &a6.s6_addr[12], 4);
+  return true;
+}
+
+class InetSocket final : public SocketFile {
+public:
+  const uint32_t id;
+
+  InetSocket(int domain, int type, int protocol)
+    : SocketFile(domain, type, protocol, DefaultSendBuffer, DefaultRecvBuffer),
+      id(nextSocketId.fetch_add(1)) {}
+
+  // Transport events, on the network thread.
+
+  void onOpen() {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (state != State::Connecting) {
+        return;
+      }
+      state = State::Connected;
+    }
+    notify(WritableEvents);
+  }
+
+  // Returns whether the transport should pause.
+  bool onData(const uint8_t* buf, size_t len) {
+    bool pause = false;
+    uint32_t events = ReadableEvents;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (state == State::Connecting) {
+        // A transport that skipped open().
+        state = State::Connected;
+        events |= WritableEvents;
+      }
+      if (state != State::Connected || shutRead || isClosed()) {
+        return false;
+      }
+      recv.push(buf, len);
+      if (!recvPaused && recv.size() >= recvBufferSize()) {
+        recvPaused = pause = true;
+      }
+    }
+    notify(events);
+    return pause;
+  }
+
+  // The peer's FIN.
+  void onEnd() {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (state != State::Connected) {
+        return;
+      }
+      peerShut = true;
+    }
+    notify(ReadableEvents | EPOLLRDHUP | EPOLLHUP);
+  }
+
+  void onDrained(size_t len) {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      inFlight -= std::min(len, inFlight);
+    }
+    notify(WritableEvents);
+  }
+
+  // The connection is gone: refused (while connecting), reset (err), or
+  // closed in order (err 0).
+  void onClose(int err) {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (state == State::Connecting) {
+        state = State::Failed;
+        error = err ? err : ECONNREFUSED;
+      } else if (state == State::Connected) {
+        state = State::Closed;
+        if (err) {
+          error = err;
+          reset = true;
+        } else {
+          peerShut = true;
+        }
+      } else {
+        return;
+      }
+      send.clear();
+      inFlight = 0;
+    }
+    notify(AllEvents);
+  }
+
+  // Network thread: hand the send ring to the transport.
+  void flushSends() {
+    // Only the network thread uses it.
+    static std::vector<uint8_t> scratch;
+    size_t n;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      flushQueued = false;
+      n = send.size();
+      if (!n) {
+        return;
+      }
+      if (state != State::Connected) {
+        send.clear();
+        return;
+      }
+      scratch.resize(n);
+      send.pop(scratch.data(), n);
+      inFlight += n;
+    }
+    _wasmfs_socket_send(id, scratch.data(), n);
+  }
+
+  uint32_t poll() override {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (type == SOCK_DGRAM) {
+      return WritableEvents;
+    }
+    uint32_t mask = 0;
+    switch (state) {
+      case State::Fresh:
+        // As Linux reports an unconnected TCP socket.
+        return WritableEvents | EPOLLHUP;
+      case State::Connecting:
+        return 0;
+      default:
+        break;
+    }
+    bool rcvShut = recvShutLocked();
+    bool sndShut = sendShutLocked();
+    if (!recv.empty() || rcvShut) {
+      mask |= ReadableEvents;
+    }
+    if (rcvShut) {
+      mask |= EPOLLRDHUP;
+    }
+    if (rcvShut && sndShut) {
+      mask |= EPOLLHUP;
+    }
+    if (sndShut || send.size() + inFlight < sendBufferSize()) {
+      mask |= WritableEvents;
+    }
+    if (error) {
+      mask |= EPOLLERR;
+    }
+    return mask;
+  }
+
+  ssize_t readv(const iovec* iov, int iovcnt, int flags) override {
+    ssize_t len = iovecLength(iov, iovcnt);
+    if (len <= 0) {
+      return len;
+    }
+    if (flags & MSG_OOB) {
+      // There is never urgent data.
+      return -EINVAL;
+    }
+    bool peek = flags & MSG_PEEK;
+    bool waitAll = (flags & MSG_WAITALL) && !peek;
+    size_t done = 0;
+    bool resume = false;
+    ssize_t result = blockUntil(
+      this,
+      ReadableEvents | EPOLLRDHUP,
+      flags,
+      recvTimeoutMs(),
+      Blocker::Restartable,
+      [&]() -> ssize_t {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        if (type == SOCK_DGRAM) {
+          return -EAGAIN;
+        }
+        if (!recv.empty()) {
+          done += recv.readv(iov, iovcnt, done, peek);
+          if (recvPaused && recv.size() <= recvBufferSize() / 2) {
+            recvPaused = false;
+            resume = true;
+          }
+          if (!waitAll || done == (size_t)len) {
+            return done;
+          }
+        }
+        if (done) {
+          // MSG_WAITALL stops short at EOF or an error.
+          return (recvShutLocked() || error) ? (ssize_t)done : -EAGAIN;
+        }
+        if (error && (state == State::Failed || state == State::Closed)) {
+          int err = error;
+          error = 0;
+          return -err;
+        }
+        if (recvShutLocked()) {
+          return 0;
+        }
+        if (state == State::Fresh) {
+          return -ENOTCONN;
+        }
+        return -EAGAIN;
+      });
+    if (resume) {
+      auto self = shared();
+      NetworkThread::post([self]() { _wasmfs_socket_resume(self->id); });
+    }
+    if (result < 0 && done) {
+      return done;
+    }
+    return result;
+  }
+
+  ssize_t writev(const iovec* iov, int iovcnt, int flags) override {
+    ssize_t len = iovecLength(iov, iovcnt);
+    if (len < 0) {
+      return len;
+    }
+    size_t done = 0;
+    ssize_t result = blockUntil(
+      this,
+      WritableEvents,
+      flags,
+      sendTimeoutMs(),
+      Blocker::Restartable,
+      [&]() -> ssize_t {
+        std::unique_lock<std::mutex> lock(mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        if (type == SOCK_DGRAM) {
+          // UDP is not supported.
+          return -ENETUNREACH;
+        }
+        if (state == State::Failed || state == State::Closed) {
+          int err = error ? error : EPIPE;
+          error = 0;
+          return done ? (ssize_t)done : -err;
+        }
+        if (shutWrite) {
+          // No SIGPIPE: its default action would end the program.
+          return done ? (ssize_t)done : -EPIPE;
+        }
+        if (state == State::Fresh) {
+          return -ENOTCONN;
+        }
+        if (state == State::Connecting) {
+          return -EAGAIN;
+        }
+        if (len == 0) {
+          return 0;
+        }
+        size_t cap = sendBufferSize();
+        size_t used = send.size() + inFlight;
+        if (used >= cap) {
+          return -EAGAIN;
+        }
+        done += send.writev(
+          iov, iovcnt, done, std::min(cap - used, (size_t)len - done));
+        bool needFlush = !flushQueued;
+        flushQueued = true;
+        lock.unlock();
+        if (needFlush) {
+          auto self = shared();
+          NetworkThread::post([self]() { self->flushSends(); });
+        }
+        return done == (size_t)len ? (ssize_t)done : -EAGAIN;
+      });
+    if (result < 0 && done) {
+      return done;
+    }
+    return result;
+  }
+
+  int bind(const sockaddr* addr, socklen_t len) override {
+    sockaddr_storage ss;
+    if (int err = copyAddress(addr, len, ss, false)) {
+      return err;
+    }
+    std::lock_guard<std::mutex> lock(mutex);
+    if (bound || state != State::Fresh || peerSet) {
+      return -EINVAL;
+    }
+    uint16_t* port = portOf(ss);
+    if (!*port) {
+      *port = htons(ephemeralPort());
+    }
+    localPort = ntohs(*port);
+    local = ss;
+    bound = true;
+    return 0;
+  }
+
+  int connect(const sockaddr* addr, socklen_t len, bool nonblock) override {
+    sockaddr_storage ss;
+    if (type == SOCK_DGRAM) {
+      // Records the default destination; sends still fail.
+      if (int err = copyAddress(addr, len, ss, true)) {
+        return err;
+      }
+      std::lock_guard<std::mutex> lock(mutex);
+      if (ss.ss_family == AF_UNSPEC) {
+        peerSet = false;
+        return 0;
+      }
+      peer = ss;
+      peerSet = true;
+      if (!localPort) {
+        localPort = ephemeralPort();
+      }
+      return 0;
+    }
+    if (int err = copyAddress(addr, len, ss, false)) {
+      return err;
+    }
+    Target target;
+    bool v6only =
+      domain == AF_INET6 && intOption(IPPROTO_IPV6, IPV6_V6ONLY, 0);
+    if (int err = targetFor(ss, v6only, target)) {
+      return err;
+    }
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (isClosed()) {
+        return -EBADF;
+      }
+      switch (state) {
+        case State::Connecting:
+          return -EALREADY;
+        case State::Connected:
+          return -EISCONN;
+        case State::Failed:
+        case State::Closed: {
+          // This socket's one connection is over.
+          int err = error ? error : ECONNABORTED;
+          error = 0;
+          return -err;
+        }
+        case State::Fresh:
+          break;
+      }
+      state = State::Connecting;
+      peer = ss;
+      peerSet = true;
+      transportUsed = true;
+      if (!localPort) {
+        localPort = ephemeralPort();
+      }
+    }
+    auto self = shared();
+    {
+      std::lock_guard<std::mutex> lock(registryMutex);
+      registry[id] = self;
+    }
+    NetworkThread::post([self, target]() {
+      _wasmfs_socket_connect(
+        self->id, target.host.c_str(), target.port, target.family);
+    });
+    if (nonblock || !Blocker::canBlock()) {
+      return -EINPROGRESS;
+    }
+    ssize_t result = blockUntil(
+      this,
+      WritableEvents,
+      0,
+      sendTimeoutMs(),
+      Blocker::Restartable,
+      [&]() -> ssize_t {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        switch (state) {
+          case State::Connecting:
+            return -EAGAIN;
+          case State::Connected:
+            return 0;
+          default: {
+            int err = error ? error : ECONNREFUSED;
+            error = 0;
+            return -err;
+          }
+        }
+      });
+    // SO_SNDTIMEO expired: the attempt goes on, as on Linux.
+    return result == -EAGAIN ? -EINPROGRESS : result;
+  }
+
+  int shutdown(int how) override {
+    if (how != SHUT_RD && how != SHUT_WR && how != SHUT_RDWR) {
+      return -EINVAL;
+    }
+    bool fin = false;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (type == SOCK_DGRAM ? !peerSet
+                             : (state == State::Fresh ||
+                                state == State::Connecting ||
+                                state == State::Failed)) {
+        return -ENOTCONN;
+      }
+      if (how != SHUT_WR) {
+        shutRead = true;
+      }
+      if (how != SHUT_RD && !shutWrite) {
+        shutWrite = true;
+        fin = state == State::Connected;
+      }
+    }
+    notify(AllEvents);
+    if (fin) {
+      // After any queued flush: tasks run in order.
+      auto self = shared();
+      NetworkThread::post([self]() {
+        self->flushSends();
+        _wasmfs_socket_shutdown(self->id);
+      });
+    }
+    return 0;
+  }
+
+  int getsockname(sockaddr* addr, socklen_t* len) override {
+    std::lock_guard<std::mutex> lock(mutex);
+    bool connected = peerSet && state != State::Fresh;
+    if (type == SOCK_DGRAM) {
+      connected = peerSet;
+    }
+    if (domain == AF_INET) {
+      sockaddr_in sin = {};
+      if (bound) {
+        memcpy(&sin, &local, sizeof(sin));
+      }
+      sin.sin_family = AF_INET;
+      sin.sin_port = htons(localPort);
+      if (connected && sin.sin_addr.s_addr == htonl(INADDR_ANY)) {
+        sin.sin_addr.s_addr = htonl(FakeLocalV4);
+      }
+      return copySockaddrOut(&sin, sizeof(sin), addr, len);
+    }
+    sockaddr_in6 sin6 = {};
+    if (bound) {
+      memcpy(&sin6, &local, sizeof(sin6));
+    }
+    sin6.sin6_family = AF_INET6;
+    sin6.sin6_port = htons(localPort);
+    if (connected && IN6_IS_ADDR_UNSPECIFIED(&sin6.sin6_addr)) {
+      in_addr peer4;
+      if (unmapV4(((sockaddr_in6&)peer).sin6_addr, peer4)) {
+        // ::ffff:10.0.2.15
+        sin6.sin6_addr.s6_addr[10] = sin6.sin6_addr.s6_addr[11] = 0xff;
+        uint32_t v4 = htonl(FakeLocalV4);
+        memcpy(&sin6.sin6_addr.s6_addr[12], &v4, 4);
+      } else {
+        // fd00::2, a unique local address.
+        sin6.sin6_addr.s6_addr[0] = 0xfd;
+        sin6.sin6_addr.s6_addr[15] = 2;
+      }
+    }
+    return copySockaddrOut(&sin6, sizeof(sin6), addr, len);
+  }
+
+  int getpeername(sockaddr* addr, socklen_t* len) override {
+    std::lock_guard<std::mutex> lock(mutex);
+    bool connected = type == SOCK_DGRAM
+                       ? peerSet
+                       : (state == State::Connected ||
+                          (state == State::Closed && !reset));
+    if (!connected) {
+      return -ENOTCONN;
+    }
+    return copySockaddrOut(&peer,
+                           domain == AF_INET ? sizeof(sockaddr_in)
+                                             : sizeof(sockaddr_in6),
+                           addr,
+                           len);
+  }
+
+private:
+  enum class State {
+    Fresh,      // never connected
+    Connecting, // waiting for the transport
+    Connected,
+    Failed,     // the connection attempt failed (error says how)
+    Closed,     // the transport closed or reset an open connection
+  };
+
+  // Guards everything below.
+  std::mutex mutex;
+  State state = State::Fresh;
+  int error = 0; // SO_ERROR
+  bool reset = false;
+  bool peerShut = false; // the peer's FIN arrived
+  bool shutRead = false;
+  bool shutWrite = false;
+  // connect() reached the transport, so close() must release it there.
+  bool transportUsed = false;
+  ByteRing recv;
+  bool recvPaused = false;
+  ByteRing send;
+  size_t inFlight = 0;
+  bool flushQueued = false;
+  bool bound = false;
+  sockaddr_storage local = {};
+  uint16_t localPort = 0;
+  bool peerSet = false;
+  sockaddr_storage peer = {};
+
+  std::shared_ptr<InetSocket> shared() {
+    return std::static_pointer_cast<InetSocket>(shared_from_this());
+  }
+
+  bool recvShutLocked() const {
+    return peerShut || shutRead || state == State::Failed ||
+           state == State::Closed;
+  }
+  bool sendShutLocked() const {
+    return shutWrite || state == State::Failed || state == State::Closed;
+  }
+
+  static uint16_t* portOf(sockaddr_storage& ss) {
+    return ss.ss_family == AF_INET ? &((sockaddr_in&)ss).sin_port
+                                   : &((sockaddr_in6&)ss).sin6_port;
+  }
+
+  // Validates an address for this socket's family and copies it.
+  int copyAddress(const sockaddr* addr,
+                  socklen_t len,
+                  sockaddr_storage& out,
+                  bool allowUnspec) {
+    if (!addr) {
+      return -EFAULT;
+    }
+    if (len < sizeof(sa_family_t)) {
+      return -EINVAL;
+    }
+    out = {};
+    if (allowUnspec && addr->sa_family == AF_UNSPEC) {
+      return 0;
+    }
+    if (domain == AF_INET) {
+      if (addr->sa_family != AF_INET) {
+        return -EAFNOSUPPORT;
+      }
+      if (len < sizeof(sockaddr_in)) {
+        return -EINVAL;
+      }
+      memcpy(&out, addr, sizeof(sockaddr_in));
+    } else {
+      if (addr->sa_family != AF_INET6) {
+        return -EAFNOSUPPORT;
+      }
+      // RFC 2133's sockaddr_in6 lacked sin6_scope_id; Linux takes both.
+      if (len < 24) {
+        return -EINVAL;
+      }
+      memcpy(&out, addr, std::min<size_t>(len, sizeof(sockaddr_in6)));
+    }
+    return 0;
+  }
+
+  static int targetFor(sockaddr_storage& ss, bool v6only, Target& target) {
+    in_addr a4;
+    if (ss.ss_family == AF_INET) {
+      auto& sin = (sockaddr_in&)ss;
+      a4 = sin.sin_addr;
+      target.port = ntohs(sin.sin_port);
+    } else {
+      auto& sin6 = (sockaddr_in6&)ss;
+      target.port = ntohs(sin6.sin6_port);
+      if (!unmapV4(sin6.sin6_addr, a4)) {
+        char buf[INET6_ADDRSTRLEN];
+        if (IN6_IS_ADDR_UNSPECIFIED(&sin6.sin6_addr)) {
+          // Linux connects to the loopback address.
+          target.host = "::1";
+        } else {
+          inet_ntop(AF_INET6, &sin6.sin6_addr, buf, sizeof(buf));
+          target.host = buf;
+        }
+        target.family = 6;
+        return 0;
+      }
+      if (v6only) {
+        return -ENETUNREACH;
+      }
+    }
+    if (a4.s_addr == htonl(INADDR_ANY)) {
+      a4.s_addr = htonl(INADDR_LOOPBACK);
+    }
+    if (lookupFakeAddress(a4, target.host)) {
+      target.family = 0;
+      return 0;
+    }
+    char buf[INET_ADDRSTRLEN];
+    inet_ntop(AF_INET, &a4, buf, sizeof(buf));
+    target.host = buf;
+    target.family = 4;
+    return 0;
+  }
+
+  int open(oflags_t) override { return 0; }
+
+  int close() override {
+    struct linger linger;
+    bool abort = lingerOption(&linger) && linger.l_onoff && !linger.l_linger;
+    bool release;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      release = transportUsed;
+      recv.clear();
+      if (abort) {
+        send.clear();
+      }
+    }
+    {
+      std::lock_guard<std::mutex> lock(registryMutex);
+      registry.erase(id);
+    }
+    closeAndNotify();
+    if (release) {
+      // Queued bytes still go out first, unless SO_LINGER asks for a reset.
+      auto self = shared();
+      NetworkThread::post([self, abort]() {
+        if (!abort) {
+          self->flushSends();
+        }
+        _wasmfs_socket_close(self->id, abort);
+      });
+    }
+    return 0;
+  }
+
+  off_t getSize() override {
+    std::lock_guard<std::mutex> lock(mutex);
+    return recv.size();
+  }
+
+  int takeError() override {
+    std::lock_guard<std::mutex> lock(mutex);
+    int err = error;
+    error = 0;
+    return err;
+  }
+
+  bool supportsLevel(int level) override {
+    switch (level) {
+      case IPPROTO_IP:
+        return true;
+      case IPPROTO_IPV6:
+        return domain == AF_INET6;
+      case IPPROTO_TCP:
+        return type == SOCK_STREAM;
+      default:
+        return false;
+    }
+  }
+
+  // A bigger SO_SNDBUF may make room.
+  void buffersChanged() override { notify(WritableEvents); }
+};
+
+} // anonymous namespace
+
+} // namespace wasmfs
+
+using namespace wasmfs;
+
+extern "C" {
+
+int __syscall_socket(
+  int domain, int type, int protocol, int unused1, int unused2, int unused3) {
+  int flags = type & (SOCK_NONBLOCK | SOCK_CLOEXEC);
+  type &= ~(SOCK_NONBLOCK | SOCK_CLOEXEC);
+  if (domain != AF_INET && domain != AF_INET6) {
+    // AF_UNIX sockets only come from socketpair().
+    return -EAFNOSUPPORT;
+  }
+  switch (type) {
+    case SOCK_STREAM:
+      if (protocol && protocol != IPPROTO_TCP) {
+        return -EPROTONOSUPPORT;
+      }
+      protocol = IPPROTO_TCP;
+      break;
+    case SOCK_DGRAM:
+      if (protocol && protocol != IPPROTO_UDP && protocol != IPPROTO_ICMP &&
+          protocol != IPPROTO_ICMPV6) {
+        return -EPROTONOSUPPORT;
+      }
+      if (!protocol) {
+        protocol = IPPROTO_UDP;
+      }
+      break;
+    case SOCK_RAW:
+      // As for an unprivileged process on Linux.
+      return -EPERM;
+    default:
+      return -EINVAL;
+  }
+  auto socket = std::make_shared<InetSocket>(domain, type, protocol);
+  return addStreamDescriptor(socket,
+                             O_RDWR | ((flags & SOCK_NONBLOCK) ? O_NONBLOCK : 0));
+}
+
+// Transport events (libwasmfs_sockets.js), on the network thread.
+
+EMSCRIPTEN_KEEPALIVE void wasmfs_socket_on_open(uint32_t id) {
+  if (auto socket = findSocket(id)) {
+    socket->onOpen();
+  }
+}
+
+// Returns 1 if the transport should pause this socket's receiving.
+EMSCRIPTEN_KEEPALIVE int
+wasmfs_socket_on_data(uint32_t id, const uint8_t* buf, size_t len) {
+  auto socket = findSocket(id);
+  return socket && socket->onData(buf, len);
+}
+
+EMSCRIPTEN_KEEPALIVE void wasmfs_socket_on_end(uint32_t id) {
+  if (auto socket = findSocket(id)) {
+    socket->onEnd();
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE void wasmfs_socket_on_drained(uint32_t id, size_t len) {
+  if (auto socket = findSocket(id)) {
+    socket->onDrained(len);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE void wasmfs_socket_on_close(uint32_t id, int err) {
+  if (auto socket = findSocket(id)) {
+    socket->onClose(err);
+  }
+}
+
+} // extern "C"
