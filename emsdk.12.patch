+// Socket options common to every socket, and socketpair(). See socket_file.h.
+
+#include "socket_file.h"
+
+#include <algorithm>
+#include <errno.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <string.h>
+#include <sys/time.h>
