+namespace wasmfs {
+
+namespace {
+
+enum class OptionKind { Unknown, Bool, Int, Blob };
+
+// The options accepted and stored. Anything else at a supported level is
+// ENOPROTOOPT. Bool options read back as 0 or 1.
+OptionKind classifyOption(int level, int name) {
+  switch (level) {
+    case SOL_SOCKET:
+      switch (name) {
+        case SO_DEBUG:
+        case SO_REUSEADDR:
+        case SO_DONTROUTE:
+        case SO_BROADCAST:
+        case SO_KEEPALIVE:
+        case SO_OOBINLINE:
+        case SO_NO_CHECK:
+        case SO_REUSEPORT:
+        case SO_PASSCRED:
+        case SO_TIMESTAMP:
+        case SO_TIMESTAMPNS:
+        case SO_ZEROCOPY:
+          return OptionKind::Bool;
+        case SO_PRIORITY:
+        case SO_RCVLOWAT:
+        case SO_SNDLOWAT:
+        case SO_MARK:
+        case SO_BUSY_POLL:
+        case SO_INCOMING_CPU:
+          return OptionKind::Int;
+        case SO_LINGER:
+        case SO_BINDTODEVICE:
+          return OptionKind::Blob;
+      }
+      break;
+    case IPPROTO_TCP:
+      switch (name) {
+        case TCP_NODELAY:
+        case TCP_CORK:
+        case TCP_QUICKACK:
+        case TCP_FASTOPEN_CONNECT:
+          return OptionKind::Bool;
+        case TCP_MAXSEG:
+        case TCP_KEEPIDLE:
+        case TCP_KEEPINTVL:
+        case TCP_KEEPCNT:
+        case TCP_SYNCNT:
+        case TCP_LINGER2:
+        case TCP_DEFER_ACCEPT:
+        case TCP_WINDOW_CLAMP:
+        case TCP_USER_TIMEOUT:
+        case TCP_FASTOPEN:
+        case TCP_NOTSENT_LOWAT:
+          return OptionKind::Int;
+      }
+      break;
+    case IPPROTO_IP:
+      switch (name) {
+        case IP_MULTICAST_LOOP:
+        case IP_MULTICAST_ALL:
+        case IP_RECVTOS:
+        case IP_RECVERR:
+        case IP_PKTINFO:
+        case IP_FREEBIND:
+        case IP_BIND_ADDRESS_NO_PORT:
+          return OptionKind::Bool;
+        case IP_TOS:
+        case IP_TTL:
+        case IP_MULTICAST_TTL:
+        case IP_MTU_DISCOVER:
+          return OptionKind::Int;
+        case IP_OPTIONS:
+        case IP_MULTICAST_IF:
+        case IP_ADD_MEMBERSHIP:
+        case IP_DROP_MEMBERSHIP:
+        case IP_ADD_SOURCE_MEMBERSHIP:
+        case IP_DROP_SOURCE_MEMBERSHIP:
+        case IP_BLOCK_SOURCE:
+        case IP_UNBLOCK_SOURCE:
+          return OptionKind::Blob;
+      }
+      break;
+    case IPPROTO_IPV6:
+      switch (name) {
+        case IPV6_V6ONLY:
+        case IPV6_MULTICAST_LOOP:
+        case IPV6_MULTICAST_ALL:
+        case IPV6_RECVTCLASS:
+        case IPV6_RECVPKTINFO:
+          return OptionKind::Bool;
+        case IPV6_UNICAST_HOPS:
+        case IPV6_MULTICAST_HOPS:
+        case IPV6_MULTICAST_IF:
+        case IPV6_TCLASS:
+        case IPV6_MTU_DISCOVER:
+          return OptionKind::Int;
+        case IPV6_ADD_MEMBERSHIP:
+        case IPV6_DROP_MEMBERSHIP:
+          return OptionKind::Blob;
+      }
+      break;
+  }
+  return OptionKind::Unknown;
+}
+
+// What getsockopt reports for an int option nobody set (Linux's defaults).
+int defaultIntOption(int level, int name) {
+  switch (level) {
+    case IPPROTO_IP:
+      switch (name) {
+        case IP_TTL:
+          return 64;
+        case IP_MULTICAST_TTL:
+        case IP_MULTICAST_LOOP:
+        case IP_MULTICAST_ALL:
+          return 1;
+      }
+      break;
+    case IPPROTO_IPV6:
+      switch (name) {
+        case IPV6_UNICAST_HOPS:
+          return 64;
+        case IPV6_MULTICAST_HOPS:
+        case IPV6_MULTICAST_LOOP:
+        case IPV6_MULTICAST_ALL:
+          return 1;
+      }
+      break;
+    case IPPROTO_TCP:
+      switch (name) {
+        case TCP_MAXSEG:
+          return 1448;
+        case TCP_KEEPIDLE:
+          return 7200;
+        case TCP_KEEPINTVL:
+          return 75;
+        case TCP_KEEPCNT:
+          return 9;
+        case TCP_SYNCNT:
+          return 6;
+      }
+      break;
+  }
+  return 0;
+}
+
+int copyOptionOut(const void* value, socklen_t size, void* out, socklen_t* len) {
+  if (!out || !len) {
+    return -EFAULT;
+  }
+  if ((int)*len < 0) {
+    return -EINVAL;
+  }
+  socklen_t n = std::min(*len, size);
+  memcpy(out, value, n);
+  *len = n;
+  return 0;
+}
+
+// SO_SNDBUF / SO_RCVBUF: Linux doubles what is set (for bookkeeping
+// overhead) and reports the doubled value.
+size_t bufferSizeFor(int value) {
+  return 2 * (size_t)std::clamp(value, 2304, 2 * 1024 * 1024);
+}
+
+int timeoutToMs(const timeval& tv) {
+  if (tv.tv_usec < 0 || tv.tv_usec >= 1000000) {
+    return -EDOM;
+  }
+  if (tv.tv_sec < 0) {
+    return 0;
+  }
+  if (tv.tv_sec == 0 && tv.tv_usec == 0) {
+    return -1;
+  }
+  long long ms = (long long)tv.tv_sec * 1000 + (tv.tv_usec + 999) / 1000;
+  return (int)std::min<long long>(ms, INT32_MAX);
+}
+
+} // anonymous namespace
+
+SocketFile::SocketFile(int domain,
+                       int type,
+                       int protocol,
+                       size_t sendBuffer,
+                       size_t recvBuffer)
+  : StreamFile(S_IRWXUGO, S_IFSOCK), domain(domain), type(type),
+    protocol(protocol), sendBuffer(sendBuffer), recvBuffer(recvBuffer) {}
+
+int SocketFile::intOption(int level, int name, int otherwise) {
+  std::lock_guard<std::mutex> lock(optionsMutex);
+  for (auto& s : stored) {
+    if (s.level == level && s.name == name) {
+      int v = 0;
+      memcpy(&v, s.value, std::min<size_t>(s.len, sizeof(v)));
+      return v;
+    }
+  }
+  return otherwise;
+}
+
+bool SocketFile::lingerOption(struct linger* out) {
+  std::lock_guard<std::mutex> lock(optionsMutex);
+  for (auto& s : stored) {
+    if (s.level == SOL_SOCKET && s.name == SO_LINGER) {
+      memcpy(out, s.value, sizeof(*out));
+      return true;
+    }
+  }
+  return false;
+}
+
+int SocketFile::getsockopt(int level, int name, void* value, socklen_t* len) {
+  if (!value || !len) {
+    return -EFAULT;
+  }
+  if (level == SOL_SOCKET) {
+    int v;
+    switch (name) {
+      case SO_TYPE:
+        v = type;
+        return copyOptionOut(&v, sizeof(v), value, len);
+      case SO_DOMAIN:
+        v = domain;
+        return copyOptionOut(&v, sizeof(v), value, len);
+      case SO_PROTOCOL:
+        v = protocol;
+        return copyOptionOut(&v, sizeof(v), value, len);
+      case SO_ERROR:
+        v = takeError();
+        return copyOptionOut(&v, sizeof(v), value, len);
+      case SO_ACCEPTCONN:
+        v = 0;
+        return copyOptionOut(&v, sizeof(v), value, len);
+      case SO_SNDBUF:
+        v = (int)sendBufferSize();
+        return copyOptionOut(&v, sizeof(v), value, len);
+      case SO_RCVBUF:
+        v = (int)recvBufferSize();
+        return copyOptionOut(&v, sizeof(v), value, len);
+      case SO_RCVTIMEO:
+      case SO_SNDTIMEO: {
+        int ms = name == SO_RCVTIMEO ? recvTimeoutMs() : sendTimeoutMs();
+        timeval tv = {0, 0};
+        if (ms >= 0) {
+          tv.tv_sec = ms / 1000;
+          tv.tv_usec = (ms % 1000) * 1000;
+        }
+        return copyOptionOut(&tv, sizeof(tv), value, len);
+      }
+    }
+  } else if (!supportsLevel(level)) {
+    return -ENOPROTOOPT;
+  }
+  OptionKind kind = classifyOption(level, name);
+  if (kind == OptionKind::Unknown) {
+    return -ENOPROTOOPT;
+  }
+  {
+    std::lock_guard<std::mutex> lock(optionsMutex);
+    for (auto& s : stored) {
+      if (s.level == level && s.name == name) {
+        return copyOptionOut(s.value, s.len, value, len);
+      }
+    }
+  }
+  if (level == SOL_SOCKET && name == SO_LINGER) {
+    struct linger l = {0, 0};
+    return copyOptionOut(&l, sizeof(l), value, len);
+  }
+  if (kind == OptionKind::Blob) {
+    *len = 0;
+    return 0;
+  }
+  int v = defaultIntOption(level, name);
+  return copyOptionOut(&v, sizeof(v), value, len);
+}
+
+int SocketFile::setsockopt(int level,
+                           int name,
+                           const void* value,
+                           socklen_t len) {
+  if ((int)len < 0) {
+    return -EINVAL;
+  }
+  if (!value && len) {
+    return -EFAULT;
+  }
+  // Int-valued options. The IP level, like Linux, also takes a single byte.
+  int intValue = 0;
+  bool haveInt = false;
+  if (len >= sizeof(int)) {
+    memcpy(&intValue, value, sizeof(int));
+    haveInt = true;
+  } else if (level == IPPROTO_IP && len >= 1) {
+    intValue = *(const unsigned char*)value;
+    haveInt = true;
+  }
+
+  if (level == SOL_SOCKET) {
+    switch (name) {
+      case SO_TYPE:
+      case SO_DOMAIN:
+      case SO_PROTOCOL:
+      case SO_ERROR:
+      case SO_ACCEPTCONN:
+        return -ENOPROTOOPT;
+      case SO_SNDBUF:
+      case SO_SNDBUFFORCE:
+      case SO_RCVBUF:
+      case SO_RCVBUFFORCE:
+        if (!haveInt) {
+          return -EINVAL;
+        }
+        if (name == SO_SNDBUF || name == SO_SNDBUFFORCE) {
+          sendBuffer.store(bufferSizeFor(intValue));
+        } else {
+          recvBuffer.store(bufferSizeFor(intValue));
+        }
+        buffersChanged();
+        return 0;
+      case SO_RCVTIMEO:
+      case SO_SNDTIMEO: {
+        if (len < sizeof(timeval)) {
+          return -EINVAL;
+        }
+        timeval tv;
+        memcpy(&tv, value, sizeof(tv));
+        int ms = timeoutToMs(tv);
+        if (ms < -1) {
+          return ms;
+        }
+        (name == SO_RCVTIMEO ? recvTimeout : sendTimeout).store(ms);
+        return 0;
+      }
+    }
+  } else if (!supportsLevel(level)) {
+    return -ENOPROTOOPT;
+  }
+
+  OptionKind kind = classifyOption(level, name);
+  if (kind == OptionKind::Unknown) {
+    return -ENOPROTOOPT;
+  }
+  Stored s = {level, name, 0, {}};
+  if (kind == OptionKind::Blob) {
+    if (level == SOL_SOCKET && name == SO_LINGER && len < sizeof(linger)) {
+      return -EINVAL;
+    }
+    if (len > sizeof(s.value)) {
+      return -EINVAL;
+    }
+    memcpy(s.value, value, len);
+    s.len = len;
+  } else {
+    if (!haveInt) {
+      return -EINVAL;
+    }
+    if (kind == OptionKind::Bool) {
+      intValue = intValue != 0;
+    }
+    memcpy(s.value, &intValue, sizeof(intValue));
+    s.len = sizeof(intValue);
+  }
+  std::lock_guard<std::mutex> lock(optionsMutex);
+  for (auto& existing : stored) {
+    if (existing.level == level && existing.name == name) {
+      existing = s;
+      return 0;
+    }
+  }
+  stored.push_back(s);
+  return 0;
+}
+
+int copySockaddrOut(const void* addr,
+                    socklen_t size,
+                    sockaddr* out,
+                    socklen_t* len) {
+  if (!out || !len) {
+    return -EFAULT;
+  }
+  if ((int)*len < 0) {
+    return -EINVAL;
+  }
+  memcpy(out, addr, std::min(*len, size));
+  *len = size;
+  return 0;
+}
+
+// socketpair(AF_UNIX, SOCK_STREAM)
+
+namespace {
+
+struct UnixPair {
+  std::mutex mutex;
+  // in[i]: bytes end i has yet to read.
+  ByteRing in[2];
+  bool shutRead[2] = {false, false};
+  // Also set when the end closes.
+  bool shutWrite[2] = {false, false};
+  bool open[2] = {true, true};
+  // Set once by createSocketPair, before either end has a descriptor.
+  std::weak_ptr<StreamFile> ends[2];
+};
+
+// Linux's default for a unix socket's send buffer.
+constexpr size_t UnixBufferSize = 212992;
+
+class UnixSocket final : public SocketFile {
+  std::shared_ptr<UnixPair> pair;
+  const int side;
+
+  int other() const { return 1 - side; }
+
+  void notifyPeer(uint32_t events) {
+    if (auto peer = pair->ends[other()].lock()) {
+      peer->notify(events);
+    }
+  }
+
+  // Our read side is shut: by us, or by the peer shutting or closing its
+  // write side. Requires the pair lock.
+  bool recvShut() const {
+    return pair->shutRead[side] || pair->shutWrite[other()];
+  }
+  bool sendShut() const {
+    return pair->shutWrite[side] || !pair->open[other()] ||
+           pair->shutRead[other()];
+  }
+
+  int open(oflags_t) override { return 0; }
+
+  int close() override {
+    {
+      std::lock_guard<std::mutex> lock(pair->mutex);
+      pair->open[side] = false;
+      pair->shutRead[side] = pair->shutWrite[side] = true;
+      pair->in[side].clear();
+    }
+    closeAndNotify();
+    notifyPeer(AllEvents);
+    return 0;
+  }
+
+  off_t getSize() override {
+    std::lock_guard<std::mutex> lock(pair->mutex);
+    return pair->in[side].size();
+  }
+
+  bool supportsLevel(int level) override { return false; }
+
+public:
+  UnixSocket(std::shared_ptr<UnixPair> pair, int side)
+    : SocketFile(AF_UNIX, SOCK_STREAM, 0, UnixBufferSize, UnixBufferSize),
+      pair(pair), side(side) {}
+
+  uint32_t poll() override {
+    std::lock_guard<std::mutex> lock(pair->mutex);
+    uint32_t mask = 0;
+    bool rcvShut = recvShut();
+    bool sndShut = sendShut();
+    if (!pair->in[side].empty() || rcvShut) {
+      mask |= ReadableEvents;
+    }
+    if (rcvShut) {
+      mask |= EPOLLRDHUP;
+    }
+    if (rcvShut && sndShut) {
+      mask |= EPOLLHUP;
+    }
+    if (sndShut || pair->in[other()].size() < sendBufferSize()) {
+      mask |= WritableEvents;
+    }
+    return mask;
+  }
+
+  ssize_t readv(const iovec* iov, int iovcnt, int flags) override {
+    ssize_t len = iovecLength(iov, iovcnt);
+    if (len <= 0) {
+      return len;
+    }
+    bool peek = flags & MSG_PEEK;
+    bool waitAll = (flags & MSG_WAITALL) && !peek;
+    size_t done = 0;
+    ssize_t result = blockUntil(
+      this,
+      ReadableEvents | EPOLLRDHUP,
+      flags,
+      recvTimeoutMs(),
+      Blocker::Restartable,
+      [&]() -> ssize_t {
+        std::unique_lock<std::mutex> lock(pair->mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        auto& in = pair->in[side];
+        bool consumed = false;
+        if (!in.empty()) {
+          done += in.readv(iov, iovcnt, done, peek);
+          consumed = !peek;
+        }
+        // MSG_WAITALL stops short at EOF.
+        ssize_t result = (done && (!waitAll || done == (size_t)len)) ||
+                             recvShut()
+                           ? (ssize_t)done
+                           : -EAGAIN;
+        lock.unlock();
+        if (consumed) {
+          notifyPeer(WritableEvents);
+        }
+        return result;
+      });
+    if (result < 0 && done) {
+      return done;
+    }
+    return result;
+  }
+
+  ssize_t writev(const iovec* iov, int iovcnt, int flags) override {
+    ssize_t len = iovecLength(iov, iovcnt);
+    if (len <= 0) {
+      return len;
+    }
+    size_t done = 0;
+    ssize_t result = blockUntil(
+      this,
+      WritableEvents,
+      flags,
+      sendTimeoutMs(),
+      Blocker::Restartable,
+      [&]() -> ssize_t {
+        std::unique_lock<std::mutex> lock(pair->mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        if (sendShut()) {
+          // No SIGPIPE: its default action would end the program.
+          return done ? (ssize_t)done : -EPIPE;
+        }
+        auto& out = pair->in[other()];
+        size_t cap = sendBufferSize();
+        if (out.size() >= cap) {
+          return -EAGAIN;
+        }
+        done += out.writev(iov, iovcnt, done, std::min(cap - out.size(), len - done));
+        lock.unlock();
+        notifyPeer(ReadableEvents);
+        return done == (size_t)len ? (ssize_t)done : -EAGAIN;
+      });
+    if (result < 0 && done) {
+      return done;
+    }
+    return result;
+  }
+
+  int bind(const sockaddr* addr, socklen_t len) override { return -EINVAL; }
+
+  int connect(const sockaddr* addr, socklen_t len, bool nonblock) override {
+    return -EISCONN;
+  }
+
+  int shutdown(int how) override {
+    if (how != SHUT_RD && how != SHUT_WR && how != SHUT_RDWR) {
+      return -EINVAL;
+    }
+    {
+      std::lock_guard<std::mutex> lock(pair->mutex);
+      if (how != SHUT_WR) {
+        pair->shutRead[side] = true;
+      }
+      if (how != SHUT_RD) {
+        pair->shutWrite[side] = true;
+      }
+    }
+    notify(AllEvents);
+    notifyPeer(AllEvents);
+    return 0;
+  }
+
+  // Both ends are unnamed: just the family.
+  int getsockname(sockaddr* addr, socklen_t* len) override {
+    sa_family_t family = AF_UNIX;
+    return copySockaddrOut(&family, sizeof(family), addr, len);
+  }
+  int getpeername(sockaddr* addr, socklen_t* len) override {
+    return getsockname(addr, len);
+  }
+};
+
+} // anonymous namespace
+
+int createSocketPair(int type, std::shared_ptr<SocketFile> ends[2]) {
+  if (type != SOCK_STREAM) {
+    return -EOPNOTSUPP;
+  }
+  auto pair = std::make_shared<UnixPair>();
+  auto a = std::make_shared<UnixSocket>(pair, 0);
+  auto b = std::make_shared<UnixSocket>(pair, 1);
+  pair->ends[0] = a;
+  pair->ends[1] = b;
+  ends[0] = a;
+  ends[1] = b;
+  return 0;
+}
+
+} // namespace wasmfs
