new file mode 100644
index 0000000..eb54dff
--- /dev/null
+++ b/system/lib/wasmfs/resolver.h
@@ -0,0 +1,21 @@
+// Copyright 2026 The Emscripten Authors.  All rights reserved.
+// Emscripten is available under two separate licenses, the MIT license and the
+// University of Illinois/NCSA Open Source License.  Both these licenses can be
+// found in the LICENSE file.
+
+#pragma once
+
+#include <netinet/in.h>
+#include <string>
+
+namespace wasmfs {
+
+// A browser cannot resolve names, so getaddrinfo() (resolver.cpp) gives each
+// hostname a fake IPv4 address in 240.67.0.0/16 (reserved space that is never
+// routed), and connect() hands the name, not the address, to the transport.
+//
+// If `addr` is one of those fake addresses, sets `name` to the hostname it
+// stands for and returns true.
+bool lookupFakeAddress(in_addr addr, std::string& name);
+
+} // namespace wasmfs
diff --git a/system/lib/wasmfs/socket_file.cpp b/system/lib/wasmfs/socket_file.cpp
new file mode 100644
