diff --git a/system/lib/wasmfs/resolver.cpp b/system/lib/wasmfs/resolver.cpp
new file mode 100644
index 0000000..968ec2a
--- /dev/null
+++ b/system/lib/wasmfs/resolver.cpp
@@ -0,0 +1,352 @@
+// Copyright 2026 The Emscripten Authors.  All rights reserved.
+// Emscripten is available under two separate licenses, the MIT license and the
+// University of Illinois/NCSA Open Source License.  Both these licenses can be
+// found in the LICENSE file.
+
+// Name resolution for WasmFS builds, in C: getaddrinfo, getnameinfo and
+// _emscripten_lookup_name (behind gethostbyname*). They replace the JS
+// versions in libcore.js, which proxy synchronously to the main thread: a
+// definition here wins because the linker only leaves a symbol to JS when no
+// linked archive defines it.
+//
+// A hostname resolves to a fake IPv4 address in 240.67.0.0/16, the same one
+// for the life of the program; connect() maps it back to the name, which the
+// transport resolves (see resolver.h). Numeric addresses pass through, and
+// "localhost" is the loopback address. Results follow the JS getaddrinfo: a
+// single entry; AF_UNSPEC yields IPv4, and an AF_INET6 request for a hostname
+// yields the IPv4-mapped address ::ffff:240.67.x.y.
+
+#include "resolver.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <mutex>
+#include <netdb.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/socket.h>
+#include <unordered_map>
+#include <vector>
+
+namespace wasmfs {
+
+namespace {
+
+constexpr uint32_t FakeNet = 0xF0430000; // 240.67.0.0, host order
+constexpr size_t MaxFakeIds = 0xFFFE;    // 240.67.0.1 .. 240.67.255.254
+
+std::mutex fakeMutex;
+std::unordered_map<std::string, uint32_t> fakeIds;
+std::vector<std::string> fakeNames; // fakeNames[id - 1]
+
+// The fake address for `name`, in network order, or 0 once all are taken.
+in_addr_t fakeAddressFor(const char* name) {
+  std::lock_guard<std::mutex> lock(fakeMutex);
+  uint32_t id;
+  auto it = fakeIds.find(name);
+  if (it != fakeIds.end()) {
+    id = it->second;
+  } else {
+    if (fakeNames.size() >= MaxFakeIds) {
+      return 0;
+    }
+    fakeNames.emplace_back(name);
+    id = fakeNames.size();
+    fakeIds.emplace(name, id);
+  }
+  return htonl(FakeNet | id);
+}
+
+bool isLocalhost(const char* name) {
+  return !strcasecmp(name, "localhost") ||
+         !strcasecmp(name, "localhost.localdomain");
+}
+
+// The IPv4 address inside an IPv4-mapped IPv6 address.
+bool unmapV4(const in6_addr& a6, in_addr& a4) {
+  if (!IN6_IS_ADDR_V4MAPPED(&a6)) {
+    return false;
+  }
+  memcpy(&a4, &a6.s6_addr[12], 4);
+  return true;
+}
+
+in6_addr mapV4(in_addr a4) {
+  in6_addr a6 = {};
+  a6.s6_addr[10] = a6.s6_addr[11] = 0xff;
+  memcpy(&a6.s6_addr[12], &a4, 4);
+  return a6;
+}
+
+// One addrinfo, laid out for emscripten's freeaddrinfo (libc's
+// musl/src/network/freeaddrinfo.c): it frees ai_addr, then the entry, so the
+// two are separate allocations and ai_canonname lives inside the entry's.
+int makeAddrinfo(int family,
+                 int type,
+                 int proto,
+                 const void* addr,
+                 uint16_t port,
+                 const char* canon,
+                 addrinfo** res) {
+  size_t canonLen = canon ? strlen(canon) + 1 : 0;
+  socklen_t salen =
+    family == AF_INET6 ? sizeof(sockaddr_in6) : sizeof(sockaddr_in);
+  auto* ai = (addrinfo*)calloc(1, sizeof(addrinfo) + canonLen);
+  auto* sa = (sockaddr*)calloc(1, salen);
+  if (!ai || !sa) {
+    free(ai);
+    free(sa);
+    return EAI_MEMORY;
+  }
+  if (family == AF_INET6) {
+    auto* sin6 = (sockaddr_in6*)sa;
+    sin6->sin6_family = AF_INET6;
+    sin6->sin6_port = htons(port);
+    memcpy(&sin6->sin6_addr, addr, sizeof(in6_addr));
+  } else {
+    auto* sin = (sockaddr_in*)sa;
+    sin->sin_family = AF_INET;
+    sin->sin_port = htons(port);
+    memcpy(&sin->sin_addr, addr, sizeof(in_addr));
+  }
+  ai->ai_family = family;
+  ai->ai_socktype = type;
+  ai->ai_protocol = proto;
+  ai->ai_addrlen = salen;
+  ai->ai_addr = sa;
+  if (canon) {
+    ai->ai_canonname = (char*)(ai + 1);
+    memcpy(ai->ai_canonname, canon, canonLen);
+  }
+  *res = ai;
+  return 0;
+}
+
+// Writes `s` to a getnameinfo buffer; EAI_OVERFLOW if it does not fit.
+int copyName(const char* s, char* out, socklen_t outLen) {
+  size_t len = strlen(s);
+  if (len >= outLen) {
+    return EAI_OVERFLOW;
+  }
+  memcpy(out, s, len + 1);
+  return 0;
+}
+
+} // anonymous namespace
+
+bool lookupFakeAddress(in_addr addr, std::string& name) {
+  uint32_t a = ntohl(addr.s_addr);
+  if ((a & 0xFFFF0000) != FakeNet) {
+    return false;
+  }
+  uint32_t id = a & 0xFFFF;
+  std::lock_guard<std::mutex> lock(fakeMutex);
+  if (id == 0 || id > fakeNames.size()) {
+    return false;
+  }
+  name = fakeNames[id - 1];
+  return true;
+}
+
+} // namespace wasmfs
+
+using namespace wasmfs;
+
+extern "C" {
+
+int getaddrinfo(const char* node,
+                const char* service,
+                const struct addrinfo* hint,
+                struct addrinfo** res) {
+  int flags = 0, family = AF_UNSPEC, type = 0, proto = 0;
+  if (hint) {
+    flags = hint->ai_flags;
+    family = hint->ai_family;
+    type = hint->ai_socktype;
+    proto = hint->ai_protocol;
+  }
+  if (type && !proto) {
+    proto = type == SOCK_DGRAM ? IPPROTO_UDP : IPPROTO_TCP;
+  }
+  if (!type && proto) {
+    type = proto == IPPROTO_UDP ? SOCK_DGRAM : SOCK_STREAM;
+  }
+  // With no type asked for this should return one entry per type; one TCP
+  // entry is what callers that pass NULL hints use.
+  if (!proto) {
+    proto = IPPROTO_TCP;
+  }
+  if (!type) {
+    type = SOCK_STREAM;
+  }
+
+  if (!node && !service) {
+    return EAI_NONAME;
+  }
+  if (flags & ~(AI_PASSIVE | AI_CANONNAME | AI_NUMERICHOST | AI_NUMERICSERV |
+                AI_V4MAPPED | AI_ALL | AI_ADDRCONFIG)) {
+    return EAI_BADFLAGS;
+  }
+  if ((flags & AI_CANONNAME) && !node) {
+    return EAI_BADFLAGS;
+  }
+  // AI_ADDRCONFIG is accepted: both families are "configured".
+  if (type != SOCK_STREAM && type != SOCK_DGRAM) {
+    return EAI_SOCKTYPE;
+  }
+  if (family != AF_UNSPEC && family != AF_INET && family != AF_INET6) {
+    return EAI_FAMILY;
+  }
+
+  uint16_t port = 0;
+  if (service) {
+    char* end;
+    unsigned long p = strtoul(service, &end, 10);
+    if (!*service || *end || p > 65535) {
+      // There is no services database.
+      return (flags & AI_NUMERICSERV) ? EAI_NONAME : EAI_SERVICE;
+    }
+    port = p;
+  }
+
+  const char* canon = (flags & AI_CANONNAME) ? node : nullptr;
+  in_addr a4;
+  in6_addr a6;
+
+  if (!node) {
+    if (family == AF_INET6) {
+      a6 = (flags & AI_PASSIVE) ? in6addr_any : in6addr_loopback;
+      return makeAddrinfo(AF_INET6, type, proto, &a6, port, nullptr, res);
+    }
+    a4.s_addr = htonl((flags & AI_PASSIVE) ? INADDR_ANY : INADDR_LOOPBACK);
+    return makeAddrinfo(AF_INET, type, proto, &a4, port, nullptr, res);
+  }
+
+  // A numeric address.
+  if (inet_pton(AF_INET, node, &a4) == 1) {
+    if (family != AF_INET6) {
+      return makeAddrinfo(AF_INET, type, proto, &a4, port, canon, res);
+    }
+    if (!(flags & AI_V4MAPPED)) {
+      return EAI_NONAME;
+    }
+    a6 = mapV4(a4);
+    return makeAddrinfo(AF_INET6, type, proto, &a6, port, canon, res);
+  }
+  if (inet_pton(AF_INET6, node, &a6) == 1) {
+    if (family == AF_INET) {
+      return EAI_NONAME;
+    }
+    return makeAddrinfo(AF_INET6, type, proto, &a6, port, canon, res);
+  }
+  if (flags & AI_NUMERICHOST) {
+    return EAI_NONAME;
+  }
+
+  // A name.
+  if (isLocalhost(node)) {
+    if (family == AF_INET6) {
+      return makeAddrinfo(
+        AF_INET6, type, proto, &in6addr_loopback, port, canon, res);
+    }
+    a4.s_addr = htonl(INADDR_LOOPBACK);
+    return makeAddrinfo(AF_INET, type, proto, &a4, port, canon, res);
+  }
+  a4.s_addr = fakeAddressFor(node);
+  if (!a4.s_addr) {
+    return EAI_MEMORY;
+  }
+  if (family == AF_INET6) {
+    a6 = mapV4(a4);
+    return makeAddrinfo(AF_INET6, type, proto, &a6, port, canon, res);
+  }
+  return makeAddrinfo(AF_INET, type, proto, &a4, port, canon, res);
+}
+
+int getnameinfo(const struct sockaddr* sa,
+                socklen_t salen,
+                char* host,
+                socklen_t hostlen,
+                char* serv,
+                socklen_t servlen,
+                int flags) {
+  if (!sa) {
+    return EAI_FAMILY;
+  }
+  in_addr a4;
+  bool isV4 = false;
+  uint16_t port;
+  const void* addr;
+  char numeric[INET6_ADDRSTRLEN];
+  if (sa->sa_family == AF_INET) {
+    if (salen < sizeof(sockaddr_in)) {
+      return EAI_FAMILY;
+    }
+    auto* sin = (const sockaddr_in*)sa;
+    a4 = sin->sin_addr;
+    isV4 = true;
+    addr = &sin->sin_addr;
+    port = ntohs(sin->sin_port);
+    inet_ntop(AF_INET, addr, numeric, sizeof(numeric));
+  } else if (sa->sa_family == AF_INET6) {
+    if (salen < sizeof(sockaddr_in6)) {
+      return EAI_FAMILY;
+    }
+    auto* sin6 = (const sockaddr_in6*)sa;
+    isV4 = unmapV4(sin6->sin6_addr, a4);
+    addr = &sin6->sin6_addr;
+    port = ntohs(sin6->sin6_port);
+    inet_ntop(AF_INET6, addr, numeric, sizeof(numeric));
+  } else {
+    return EAI_FAMILY;
+  }
+
+  if (host && hostlen) {
+    std::string name;
+    bool named = false;
+    if (!(flags & NI_NUMERICHOST)) {
+      if (isV4) {
+        named = lookupFakeAddress(a4, name);
+        if (!named && a4.s_addr == htonl(INADDR_LOOPBACK)) {
+          name = "localhost";
+          named = true;
+        }
+      } else if (IN6_IS_ADDR_LOOPBACK((const in6_addr*)addr)) {
+        name = "localhost";
+        named = true;
+      }
+    }
+    if (!named && (flags & NI_NAMEREQD)) {
+      return EAI_NONAME;
+    }
+    if (int err = copyName(named ? name.c_str() : numeric, host, hostlen)) {
+      return err;
+    }
+  }
+  if (serv && servlen) {
+    // There is no services database: always the number.
+    char buf[8];
+    snprintf(buf, sizeof(buf), "%u", (unsigned)port);
+    if (int err = copyName(buf, serv, servlen)) {
+      return err;
+    }
+  }
+  return 0;
+}
+
+// What gethostbyname*() resolve through (libc's lookup_name.c): the IPv4
+// address for `name`, in network order.
+uint32_t _emscripten_lookup_name(const char* name) {
+  in_addr a4;
+  if (inet_pton(AF_INET, name, &a4) == 1) {
+    return a4.s_addr;
+  }
+  if (isLocalhost(name)) {
+    return htonl(INADDR_LOOPBACK);
+  }
+  return fakeAddressFor(name);
+}
+
+} // extern "C"
