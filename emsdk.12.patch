diff --git a/src/lib/libwasmfs_sockets.js b/src/lib/libwasmfs_sockets.js
new file mode 100644
index 0000000..64da31b
--- /dev/null
+++ b/src/lib/libwasmfs_sockets.js
@@ -0,0 +1,173 @@
+/**
+ * @license
+ * Copyright 2026 The Emscripten Authors
+ * SPDX-License-Identifier: MIT
+ */
+
+// The transport behind WasmFS's AF_INET/AF_INET6 sockets
+// (system/lib/wasmfs/inet_socket.cpp).
+//
+// A browser cannot open TCP connections, so the embedder supplies the
+// transport, an object with these methods:
+//
+//   connect(id, host, port, family, events)
+//       Open a connection for socket `id`. `family` is 4 or 6 when `host` is
+//       an address literal, and 0 when it is a host name: getaddrinfo() gives
+//       names fake addresses, and connect() hands the name back. Report the
+//       outcome with events.open(id) or events.close(id, error).
+//   send(id, bytes)
+//       Send `bytes`, a Uint8Array the transport now owns. Call
+//       events.drained(id, n) once n bytes passed to send() no longer occupy
+//       memory on the transport's side (from within send() is fine); until
+//       then they count against the socket's send buffer (SO_SNDBUF), and a
+//       full buffer blocks the writer.
+//   shutdown(id)                       optional
+//       Half-close (TCP FIN) after the bytes already sent.
+//   close(id, abort)
+//       Release the connection: an orderly close, or a reset if `abort`
+//       (SO_LINGER with a zero timeout). May follow events.close(id).
+//   pause(id), resume(id)              optional
+//       Receive flow control: the socket holds SO_RCVBUF unread bytes / a
+//       reader has drained it to half that. Without them the receive buffer
+//       grows without bound.
+//
+// and reports through `events`, the object passed to connect():
+//
+//   events.open(id)           connected
+//   events.data(id, bytes)    bytes received (a Uint8Array or ArrayBuffer)
+//   events.end(id)            the peer closed its side (FIN): EOF after the data
+//   events.drained(id, n)     n sent bytes have left the transport
+//   events.close(id, error)   the connection is gone. `error` is undefined or 0
+//                             for an orderly close, else one of 'ECONNREFUSED',
+//                             'ECONNRESET', 'ETIMEDOUT', 'EHOSTUNREACH',
+//                             'ENETUNREACH', 'ECONNABORTED', 'EPIPE' (anything
+//                             else reads as ECONNRESET). While connecting it
+//                             fails the connect (ECONNREFUSED if no error).
+//
+// All of it happens on one dedicated network pthread, never the main browser
+// thread, and events must be delivered there: whatever does the transport's
+// I/O (a WebSocket, say) belongs to that worker. The transport is looked up on
+// each connect, in that worker, as Module['wasmfsSocketTransport'] or
+// globalThis.wasmfsSocketTransport, so install it with --pre-js (pre-js code
+// runs in every worker) or a --js-library __postset. With none installed,
+// connect() fails with ENETUNREACH. Without pthreads the transport runs on the
+// main thread, and only non-blocking sockets are useful.
+
+addToLibrary({
+  $wasmfsSocketGetTransport: () => Module['wasmfsSocketTransport'] ?? globalThis['wasmfsSocketTransport'],
+
+  $wasmfsSocketErrno: (error) => {
+    if (!error) return 0;
+    switch (error) {
+      case 'ECONNREFUSED': return {{{ cDefs.ECONNREFUSED }}};
+      case 'ECONNRESET': return {{{ cDefs.ECONNRESET }}};
+      case 'ETIMEDOUT': return {{{ cDefs.ETIMEDOUT }}};
+      case 'EHOSTUNREACH': return {{{ cDefs.EHOSTUNREACH }}};
+      case 'ENETUNREACH': return {{{ cDefs.ENETUNREACH }}};
+      case 'ECONNABORTED': return {{{ cDefs.ECONNABORTED }}};
+      case 'EPIPE': return {{{ cDefs.EPIPE }}};
+    }
+    return {{{ cDefs.ECONNRESET }}};
+  },
+
+  // Received bytes are staged in wasm memory, 64 KiB at a time.
+  $wasmfsSocketScratch: 0,
+
+  // The `events` object handed to the transport. Its keys are quoted: they
+  // are an interface to code closure does not see.
+  $wasmfsSocketEvents__deps: ['$wasmfsSocketErrno', '$wasmfsSocketGetTransport', '$wasmfsSocketScratch',
+                              'malloc', 'wasmfs_socket_on_open', 'wasmfs_socket_on_data',
+                              'wasmfs_socket_on_end', 'wasmfs_socket_on_drained',
+                              'wasmfs_socket_on_close'],
+  $wasmfsSocketEvents: () => ({
+    'open': (id) => _wasmfs_socket_on_open(id),
+    'data': (id, bytes) => {
+      if (!(bytes instanceof Uint8Array)) bytes = new Uint8Array(bytes);
+      if (!wasmfsSocketScratch) wasmfsSocketScratch = _malloc(65536);
+      var pause = 0;
+      for (var offset = 0; offset < bytes.length; offset += 65536) {
+        var chunk = bytes.subarray(offset, offset + 65536);
+        HEAPU8.set(chunk, wasmfsSocketScratch);
+        pause |= _wasmfs_socket_on_data(id, wasmfsSocketScratch, chunk.length);
+      }
+      if (pause) wasmfsSocketGetTransport()?.['pause']?.(id);
+    },
+    'end': (id) => _wasmfs_socket_on_end(id),
+    'drained': (id, n) => _wasmfs_socket_on_drained(id, n),
+    'close': (id, error) => _wasmfs_socket_on_close(id, wasmfsSocketErrno(error)),
+  }),
+
+  // Runs once on the network thread (pthread builds only). Proxied tasks reach
+  // it through its mailbox: Atomics.waitAsync where the browser has it, else a
+  // postMessage the main thread relays. In the second case also poll the
+  // queue, so a busy main thread cannot stall the network.
+#if PTHREADS
+  _wasmfs_socket_thread_init__deps: ['emscripten_proxy_execute_queue', '$waitAsyncPolyfilled'],
+#endif
+  _wasmfs_socket_thread_init: (queue) => {
+#if PTHREADS
+    if (!waitAsyncPolyfilled) return;
+    var interval = setInterval(() => {
+      if (ABORT) {
+        clearInterval(interval);
+      } else {
+        _emscripten_proxy_execute_queue(queue);
+      }
+    }, 4);
+#endif
+  },
+
+  _wasmfs_socket_connect__deps: ['$wasmfsSocketGetTransport', '$wasmfsSocketEvents', '$UTF8ToString',
+                                 'wasmfs_socket_on_close'],
+  _wasmfs_socket_connect: (id, host, port, family) => {
+    var transport = wasmfsSocketGetTransport();
+    if (!transport) {
+      _wasmfs_socket_on_close(id, {{{ cDefs.ENETUNREACH }}});
+      return;
+    }
+    try {
+      transport['connect'](id, UTF8ToString(host), port, family, wasmfsSocketEvents());
+    } catch (e) {
+      err(`wasmfs: socket transport connect() threw: ${e}`);
+      _wasmfs_socket_on_close(id, {{{ cDefs.ECONNREFUSED }}});
+    }
+  },
+
+  _wasmfs_socket_send__deps: ['$wasmfsSocketGetTransport', 'wasmfs_socket_on_close'],
+  _wasmfs_socket_send: (id, buf, len) => {
+    var bytes = HEAPU8.slice(buf, buf + len);
+    try {
+      wasmfsSocketGetTransport()['send'](id, bytes);
+    } catch (e) {
+      err(`wasmfs: socket transport send() threw: ${e}`);
+      _wasmfs_socket_on_close(id, {{{ cDefs.ECONNRESET }}});
+    }
+  },
+
+  _wasmfs_socket_shutdown__deps: ['$wasmfsSocketGetTransport'],
+  _wasmfs_socket_shutdown: (id) => {
+    try {
+      wasmfsSocketGetTransport()?.['shutdown']?.(id);
+    } catch (e) {
+      err(`wasmfs: socket transport shutdown() threw: ${e}`);
+    }
+  },
+
+  _wasmfs_socket_close__deps: ['$wasmfsSocketGetTransport'],
+  _wasmfs_socket_close: (id, abort) => {
+    try {
+      wasmfsSocketGetTransport()?.['close'](id, !!abort);
+    } catch (e) {
+      err(`wasmfs: socket transport close() threw: ${e}`);
+    }
+  },
+
+  _wasmfs_socket_resume__deps: ['$wasmfsSocketGetTransport'],
+  _wasmfs_socket_resume: (id) => {
+    try {
+      wasmfsSocketGetTransport()?.['resume']?.(id);
+    } catch (e) {
+      err(`wasmfs: socket transport resume() threw: ${e}`);
+    }
+  },
+});
