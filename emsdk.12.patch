diff --git a/system/lib/wasmfs/epoll.cpp b/system/lib/wasmfs/epoll.cpp
new file mode 100644
index 0000000..eb10594
--- /dev/null
+++ b/system/lib/wasmfs/epoll.cpp
@@ -0,0 +1,523 @@
+// Copyright 2026 The Emscripten Authors.  All rights reserved.
+// Emscripten is available under two separate licenses, the MIT license and the
+// University of Illinois/NCSA Open Source License.  Both these licenses can be
+// found in the LICENSE file.
+
+// epoll(7) over WasmFS stream files, with the semantics emscripten's JS FS
+// gained in #27207 (libepoll.js):
+//
+//  - A registration keys on the descriptor and its open file description, as
+//    Linux keys on (fd, struct file). Closing the description's last
+//    descriptor evicts it; a dup of the epoll fd is the same instance.
+//  - Each registration listens on its file. A notification that matches its
+//    events puts it on the ready list (and wakes the epoll's own listeners:
+//    waiters, and epolls that watch this one). epoll_wait takes registrations
+//    off the front of the list and re-checks each against the file's current
+//    readiness: a level-triggered one still ready goes back on the tail, an
+//    EPOLLET one waits for the next notification, an EPOLLONESHOT one is
+//    disarmed until EPOLL_CTL_MOD. Registrations a full wait did not reach
+//    stay at the front, so successive waits rotate through ready files.
+//  - EPOLL_CTL_ADD and EPOLL_CTL_MOD sample the file's level, so an
+//    already-ready file is reported without a further notification.
+//  - EPOLLERR and EPOLLHUP are always reported; EPOLLRDHUP only if asked for.
+//  - EPOLLEXCLUSIVE: of the epolls watching one file exclusively, each
+//    notification wakes one, in turn. It cannot be combined with
+//    EPOLLONESHOT, used on a nested epoll, or modified.
+//  - An epoll may watch another; loops, and chains of more than five epoll
+//    instances, fail with ELOOP.
+//  - epoll_event is 16 bytes (aligned, not x86-64's packed 12).
+// Locking: see the lock order in stream_file.h.
+
+#include <algorithm>
+#include <emscripten/syscalls.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <map>
+#include <signal.h>
+#include <sys/epoll.h>
+#include <vector>
+
+#include "file_table.h"
+#include "stream_file.h"
+#include "wasmfs.h"
+
+namespace wasmfs {
+
+namespace {
+
+// Linux's EP_MAX_NESTS (4) plus the leaf level.
+constexpr int MaxEpollDepth = 5;
+
+// The bits that configure a registration rather than ask for readiness.
+constexpr uint32_t ConfigEvents =
+  EPOLLET | EPOLLONESHOT | EPOLLEXCLUSIVE | EPOLLWAKEUP;
+
+// What a registration for `events` reports.
+uint32_t reportable(uint32_t events) {
+  return (events & ~ConfigEvents) | EPOLLERR | EPOLLHUP;
+}
+
+// Serializes the loop and depth checks of an EPOLL_CTL_ADD that nests an
+// epoll. Taken before any epoll's mutex.
+std::mutex nestMutex;
+
+} // anonymous namespace
+
+class EpollFile final : public StreamFile {
+  struct Reg final : Listener {
+    EpollFile* ep;
+    int fd;
+    std::shared_ptr<StreamFile> file;
+    // Guarded by ep->readyMutex.
+    uint32_t events = 0;
+    uint64_t data = 0;
+    bool armed = true;
+    bool listed = false;
+    Reg* rdPrev = nullptr;
+    Reg* rdNext = nullptr;
+
+    bool notify(uint32_t ev) override;
+  };
+
+  // The interest set. mutex also serializes epoll_ctl, harvesting and poll().
+  std::mutex mutex;
+  std::map<std::pair<int, StreamFile*>, std::unique_ptr<Reg>> interest;
+
+  // The ready list.
+  std::mutex readyMutex;
+  Reg* rdHead = nullptr;
+  Reg* rdTail = nullptr;
+  size_t rdCount = 0;
+
+  // These two require readyMutex.
+  void listLocked(Reg* r) {
+    if (r->listed) {
+      return;
+    }
+    r->listed = true;
+    r->rdPrev = rdTail;
+    r->rdNext = nullptr;
+    if (rdTail) {
+      rdTail->rdNext = r;
+    } else {
+      rdHead = r;
+    }
+    rdTail = r;
+    rdCount++;
+  }
+  void unlistLocked(Reg* r) {
+    if (!r->listed) {
+      return;
+    }
+    r->listed = false;
+    if (r->rdPrev) {
+      r->rdPrev->rdNext = r->rdNext;
+    } else {
+      rdHead = r->rdNext;
+    }
+    if (r->rdNext) {
+      r->rdNext->rdPrev = r->rdPrev;
+    } else {
+      rdTail = r->rdPrev;
+    }
+    r->rdPrev = r->rdNext = nullptr;
+    rdCount--;
+  }
+
+  // Requires mutex. Destroys `r`.
+  void evict(Reg* r) {
+    // Once off the file's list, no notification can reach it.
+    r->file->removeListener(r);
+    {
+      std::lock_guard<std::mutex> lock(readyMutex);
+      unlistLocked(r);
+    }
+    auto key = std::make_pair(r->fd, r->file.get());
+    interest.erase(key);
+  }
+
+  // Requires mutex. Delivers up to maxevents ready registrations.
+  int harvest(epoll_event* out, int maxevents) {
+    size_t budget;
+    {
+      std::lock_guard<std::mutex> lock(readyMutex);
+      budget = rdCount;
+    }
+    // Notifications only append, and only ctl (excluded by mutex) removes, so
+    // popping `budget` entries visits exactly what was listed on entry.
+    int n = 0;
+    while (budget-- && n < maxevents) {
+      Reg* r;
+      uint32_t events;
+      uint64_t data;
+      bool armed;
+      {
+        std::lock_guard<std::mutex> lock(readyMutex);
+        r = rdHead;
+        if (!r) {
+          break;
+        }
+        unlistLocked(r);
+        events = r->events;
+        data = r->data;
+        armed = r->armed;
+      }
+      if (r->file->isClosed()) {
+        evict(r);
+        continue;
+      }
+      if (!armed) {
+        continue;
+      }
+      uint32_t revents = r->file->poll() & reportable(events);
+      if (!revents) {
+        // The edge is gone (another reader drained it).
+        continue;
+      }
+      out[n].events = revents;
+      out[n].data.u64 = data;
+      n++;
+      std::lock_guard<std::mutex> lock(readyMutex);
+      if (events & EPOLLONESHOT) {
+        r->armed = false;
+      } else if (!(events & EPOLLET)) {
+        listLocked(r);
+      }
+    }
+    return n;
+  }
+
+  // The longest chain of epolls from this one down (this one counts), or -1
+  // if `goal` is on it. Requires nestMutex and goal's mutex; never takes the
+  // latter.
+  int chainDepth(EpollFile* goal) {
+    if (this == goal) {
+      return -1;
+    }
+    std::vector<std::shared_ptr<StreamFile>> children;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      for (auto& [key, reg] : interest) {
+        if (reg->file->asEpoll()) {
+          children.push_back(reg->file);
+        }
+      }
+    }
+    int deepest = 0;
+    for (auto& child : children) {
+      int depth = child->asEpoll()->chainDepth(goal);
+      if (depth < 0) {
+        return -1;
+      }
+      deepest = std::max(deepest, depth);
+    }
+    return 1 + deepest;
+  }
+
+  int open(oflags_t) override { return 0; }
+
+  int close() override {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      for (auto& [key, reg] : interest) {
+        reg->file->removeListener(reg.get());
+      }
+      {
+        std::lock_guard<std::mutex> readyLock(readyMutex);
+        rdHead = rdTail = nullptr;
+        rdCount = 0;
+      }
+      interest.clear();
+    }
+    closeAndNotify();
+    return 0;
+  }
+
+  off_t getSize() override { return 0; }
+
+public:
+  EpollFile() : StreamFile(S_IRUSR | S_IWUSR, 0) {}
+
+  // close() has normally emptied the interest set; never leave a watched file
+  // pointing at a destroyed registration.
+  ~EpollFile() {
+    for (auto& [key, reg] : interest) {
+      reg->file->removeListener(reg.get());
+    }
+  }
+
+  EpollFile* asEpoll() override { return this; }
+
+  // Readable while a wait would deliver something.
+  uint32_t poll() override {
+    std::lock_guard<std::mutex> lock(mutex);
+    std::vector<std::pair<Reg*, uint32_t>> listed;
+    {
+      std::lock_guard<std::mutex> readyLock(readyMutex);
+      for (Reg* r = rdHead; r; r = r->rdNext) {
+        if (r->armed) {
+          listed.emplace_back(r, r->events);
+        }
+      }
+    }
+    for (auto& [r, events] : listed) {
+      if (!r->file->isClosed() && (r->file->poll() & reportable(events))) {
+        return ReadableEvents;
+      }
+    }
+    return 0;
+  }
+
+  ssize_t readv(const iovec* iov, int iovcnt, int flags) override {
+    return -EINVAL;
+  }
+  ssize_t writev(const iovec* iov, int iovcnt, int flags) override {
+    return -EINVAL;
+  }
+
+  int ctl(int op, int fd, const epoll_event* ev) {
+    auto openFile = wasmFS.getFileTable().locked().getEntry(fd);
+    if (!openFile) {
+      return -EBADF;
+    }
+    std::shared_ptr<StreamFile> target;
+    {
+      auto locked = openFile->locked();
+      if (auto dataFile = locked.getFile()->dynCast<DataFile>()) {
+        if (auto* stream = dataFile->asStream()) {
+          target = stream->sharedStream();
+        }
+      }
+    }
+    if (op != EPOLL_CTL_ADD && op != EPOLL_CTL_MOD && op != EPOLL_CTL_DEL) {
+      return -EINVAL;
+    }
+    // Regular files have no readiness to watch.
+    if (!target) {
+      return -EPERM;
+    }
+    if (target.get() == this) {
+      return -EINVAL;
+    }
+    if (op != EPOLL_CTL_DEL && !ev) {
+      return -EFAULT;
+    }
+    uint32_t events = op == EPOLL_CTL_DEL ? 0 : ev->events;
+    uint64_t data = op == EPOLL_CTL_DEL ? 0 : ev->data.u64;
+    EpollFile* nested = target->asEpoll();
+
+    std::unique_lock<std::mutex> nestLock(nestMutex, std::defer_lock);
+    if (nested && op == EPOLL_CTL_ADD) {
+      nestLock.lock();
+    }
+    std::lock_guard<std::mutex> lock(mutex);
+
+    auto key = std::make_pair(fd, target.get());
+    auto it = interest.find(key);
+    Reg* r = it == interest.end() ? nullptr : it->second.get();
+    switch (op) {
+      case EPOLL_CTL_DEL:
+        if (!r) {
+          return -ENOENT;
+        }
+        evict(r);
+        return 0;
+      case EPOLL_CTL_ADD: {
+        if (r) {
+          return -EEXIST;
+        }
+        if ((events & EPOLLEXCLUSIVE) && ((events & EPOLLONESHOT) || nested)) {
+          return -EINVAL;
+        }
+        if (nested) {
+          int depth = nested->chainDepth(this);
+          if (depth < 0 || 1 + depth > MaxEpollDepth) {
+            return -ELOOP;
+          }
+        }
+        auto reg = std::make_unique<Reg>();
+        reg->ep = this;
+        reg->fd = fd;
+        reg->file = target;
+        reg->events = events;
+        reg->data = data;
+        // The registration filters for itself: its events change under
+        // readyMutex while it stays on the file's list.
+        reg->interest = ~0u;
+        reg->exclusive = events & EPOLLEXCLUSIVE;
+        r = reg.get();
+        interest.emplace(key, std::move(reg));
+        target->addListener(r);
+        break;
+      }
+      case EPOLL_CTL_MOD: {
+        if (!r) {
+          return -ENOENT;
+        }
+        if ((events | r->events) & EPOLLEXCLUSIVE) {
+          return -EINVAL;
+        }
+        std::lock_guard<std::mutex> readyLock(readyMutex);
+        r->events = events;
+        r->data = data;
+        r->armed = true;
+        break;
+      }
+    }
+    // Arming is itself an edge: report a file that is already ready.
+    if (target->poll() & reportable(events)) {
+      {
+        std::lock_guard<std::mutex> readyLock(readyMutex);
+        listLocked(r);
+      }
+      notify(ReadableEvents);
+    }
+    return 0;
+  }
+
+  int wait(epoll_event* out, int maxevents, int timeoutMs) {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      int n = harvest(out, maxevents);
+      if (n || timeoutMs == 0 || !Blocker::canBlock()) {
+        return n;
+      }
+    }
+    Blocker blocker(timeoutMs, Blocker::Interruptible);
+    blocker.watch(sharedStream(), ReadableEvents);
+    while (true) {
+      blocker.arm();
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        int n = harvest(out, maxevents);
+        if (n) {
+          return n;
+        }
+      }
+      int err = blocker.wait();
+      if (err == -ETIMEDOUT) {
+        return 0;
+      }
+      if (err) {
+        return err;
+      }
+    }
+  }
+};
+
+bool EpollFile::Reg::notify(uint32_t ev) {
+  {
+    std::lock_guard<std::mutex> lock(ep->readyMutex);
+    // A closing file is listed even when disarmed, so a wait evicts it.
+    if (!(ev & StreamClosedEvent) &&
+        (!armed || !(ev & (events | EPOLLERR | EPOLLHUP)))) {
+      return false;
+    }
+    ep->listLocked(this);
+  }
+  ep->notify(ReadableEvents);
+  return true;
+}
+
+namespace {
+
+EpollFile* getEpoll(int epfd, std::shared_ptr<StreamFile>& holder, int& err) {
+  auto openFile = wasmFS.getFileTable().locked().getEntry(epfd);
+  if (!openFile) {
+    err = -EBADF;
+    return nullptr;
+  }
+  auto locked = openFile->locked();
+  auto dataFile = locked.getFile()->dynCast<DataFile>();
+  StreamFile* stream = dataFile ? dataFile->asStream() : nullptr;
+  if (!stream || !stream->asEpoll()) {
+    err = -EINVAL;
+    return nullptr;
+  }
+  holder = stream->sharedStream();
+  return stream->asEpoll();
+}
+
+int validateWait(struct epoll_event* ev, int maxevents) {
+  if (maxevents <= 0 || maxevents > INT_MAX / (int)sizeof(epoll_event)) {
+    return -EINVAL;
+  }
+  if (!ev) {
+    return -EFAULT;
+  }
+  return 0;
+}
+
+} // anonymous namespace
+
+} // namespace wasmfs
+
+using namespace wasmfs;
+
+extern "C" {
+
+int __syscall_epoll_create1(int flags) {
+  // EPOLL_CLOEXEC is accepted and means nothing: there is no exec.
+  if (flags & ~EPOLL_CLOEXEC) {
+    return -EINVAL;
+  }
+  return addStreamDescriptor(std::make_shared<EpollFile>(), O_RDWR);
+}
+
+int __syscall_epoll_ctl(int epfd, int op, int fd, struct epoll_event* ev) {
+  std::shared_ptr<StreamFile> holder;
+  int err;
+  EpollFile* ep = getEpoll(epfd, holder, err);
+  if (!ep) {
+    return err;
+  }
+  return ep->ctl(op, fd, ev);
+}
+
+int __syscall_epoll_pwait(int epfd,
+                          struct epoll_event* ev,
+                          int maxevents,
+                          int timeout,
+                          const sigset_t* sigmask,
+                          size_t sigsetsize) {
+  if (int err = validateWait(ev, maxevents)) {
+    return err;
+  }
+  std::shared_ptr<StreamFile> holder;
+  int err;
+  EpollFile* ep = getEpoll(epfd, holder, err);
+  if (!ep) {
+    return err;
+  }
+  sigset_t old;
+  if (sigmask) {
+    pthread_sigmask(SIG_SETMASK, sigmask, &old);
+  }
+  int n = ep->wait(ev, maxevents, timeout);
+  if (sigmask) {
+    pthread_sigmask(SIG_SETMASK, &old, nullptr);
+  }
+  return n;
+}
+
+// libc routes zero-timeout epoll_wait()/epoll_pwait() here (musl's epoll.c).
+int __syscall_epoll_pwait_nonblocking(int epfd,
+                                      struct epoll_event* ev,
+                                      int maxevents) {
+  if (int err = validateWait(ev, maxevents)) {
+    return err;
+  }
+  std::shared_ptr<StreamFile> holder;
+  int err;
+  EpollFile* ep = getEpoll(epfd, holder, err);
+  if (!ep) {
+    return err;
+  }
+  return ep->wait(ev, maxevents, 0);
+}
+
+} // extern "C"
diff --git a/system/lib/wasmfs/eventfd.cpp b/system/lib/wasmfs/eventfd.cpp
new file mode 100644
index 0000000..09a15ea
--- /dev/null
+++ b/system/lib/wasmfs/eventfd.cpp
@@ -0,0 +1,147 @@
+// Copyright 2026 The Emscripten Authors.  All rights reserved.
+// Emscripten is available under two separate licenses, the MIT license and the
+// University of Illinois/NCSA Open Source License.  Both these licenses can be
+// found in the LICENSE file.
+
+// eventfd(2): a 64-bit counter. A read returns it and resets it to zero (or,
+// with EFD_SEMAPHORE, returns 1 and decrements it), blocking while it is zero;
+// a write adds to it, blocking while that would pass 0xfffffffffffffffe.
+
+#include <algorithm>
+#include <emscripten/syscalls.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/eventfd.h>
+
+#include "stream_file.h"
+
+namespace wasmfs {
+
+namespace {
+
+constexpr uint64_t EventFdMax = UINT64_MAX - 1;
+
+// Gathers exactly 8 bytes from the iovecs, or scatters 8 bytes into them.
+void gather8(const iovec* iov, int iovcnt, uint8_t out[8]) {
+  size_t done = 0;
+  for (int i = 0; i < iovcnt && done < 8; i++) {
+    size_t n = std::min(iov[i].iov_len, 8 - done);
+    memcpy(out + done, iov[i].iov_base, n);
+    done += n;
+  }
+}
+
+void scatter8(const iovec* iov, int iovcnt, const uint8_t in[8]) {
+  size_t done = 0;
+  for (int i = 0; i < iovcnt && done < 8; i++) {
+    size_t n = std::min(iov[i].iov_len, 8 - done);
+    memcpy(iov[i].iov_base, in + done, n);
+    done += n;
+  }
+}
+
+class EventFdFile final : public StreamFile {
+  std::mutex mutex;
+  uint64_t count;
+  const bool semaphore;
+
+  int open(oflags_t) override { return 0; }
+  int close() override {
+    closeAndNotify();
+    return 0;
+  }
+  off_t getSize() override { return 0; }
+
+public:
+  EventFdFile(uint64_t initial, bool semaphore)
+    : StreamFile(S_IRUSR | S_IWUSR, 0), count(initial), semaphore(semaphore) {
+  }
+
+  uint32_t poll() override {
+    std::lock_guard<std::mutex> lock(mutex);
+    uint32_t mask = 0;
+    if (count) {
+      mask |= ReadableEvents;
+    }
+    if (count < EventFdMax) {
+      mask |= WritableEvents;
+    }
+    return mask;
+  }
+
+  ssize_t readv(const iovec* iov, int iovcnt, int flags) override {
+    ssize_t len = iovecLength(iov, iovcnt);
+    if (len < 0) {
+      return len;
+    }
+    if (len < 8) {
+      return -EINVAL;
+    }
+    uint64_t value = 0;
+    ssize_t result = blockUntil(
+      this, ReadableEvents, flags, -1, Blocker::Restartable, [&]() -> ssize_t {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        if (!count) {
+          return -EAGAIN;
+        }
+        value = semaphore ? 1 : count;
+        count -= value;
+        return 8;
+      });
+    if (result == 8) {
+      scatter8(iov, iovcnt, (const uint8_t*)&value);
+      notify(WritableEvents);
+    }
+    return result;
+  }
+
+  ssize_t writev(const iovec* iov, int iovcnt, int flags) override {
+    ssize_t len = iovecLength(iov, iovcnt);
+    if (len < 0) {
+      return len;
+    }
+    if (len < 8) {
+      return -EINVAL;
+    }
+    uint64_t value;
+    gather8(iov, iovcnt, (uint8_t*)&value);
+    if (value == UINT64_MAX) {
+      return -EINVAL;
+    }
+    ssize_t result = blockUntil(
+      this, WritableEvents, flags, -1, Blocker::Restartable, [&]() -> ssize_t {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (isClosed()) {
+          return -EBADF;
+        }
+        if (EventFdMax - count < value) {
+          return -EAGAIN;
+        }
+        count += value;
+        return 8;
+      });
+    if (result == 8 && value) {
+      notify(ReadableEvents);
+    }
+    return result;
+  }
+};
+
+} // anonymous namespace
+
+} // namespace wasmfs
+
+using namespace wasmfs;
+
+extern "C" int __syscall_eventfd2(unsigned int initval, int flags) {
+  if (flags & ~(EFD_CLOEXEC | EFD_NONBLOCK | EFD_SEMAPHORE)) {
+    return -EINVAL;
+  }
+  auto file = std::make_shared<EventFdFile>(initval, flags & EFD_SEMAPHORE);
+  return addStreamDescriptor(file,
+                             O_RDWR | ((flags & EFD_NONBLOCK) ? O_NONBLOCK : 0));
+}
