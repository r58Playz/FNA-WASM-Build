+extern "C" {
+// libwasmfs_sockets.js. All but the first run on the network thread only.
+void _wasmfs_socket_thread_init(em_proxying_queue* queue);
+void _wasmfs_socket_connect(uint32_t id,
+                            const char* host,
+                            int port,
+                            int family);
+void _wasmfs_socket_send(uint32_t id, const uint8_t* buf, size_t len);
+void _wasmfs_socket_shutdown(uint32_t id);
+void _wasmfs_socket_close(uint32_t id, int abort);
+void _wasmfs_socket_resume(uint32_t id);
