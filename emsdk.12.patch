+// Sockets: the interface the socket syscalls dispatch through, option storage
+// common to every kind, and socketpair(). AF_INET/AF_INET6 sockets are in
+// inet_socket.cpp, linked only when socket() is.
+
+#pragma once
+
+#include <sys/socket.h>
+#include <vector>
+
+#include "stream_file.h"
+
+namespace wasmfs {
+
+class SocketFile : public StreamFile {
+public:
+  const int domain;   // AF_INET, AF_INET6 or AF_UNIX
+  const int type;     // SOCK_STREAM or SOCK_DGRAM, without SOCK_* flags
+  const int protocol; // as reported by SO_PROTOCOL
+
+  SocketFile(int domain,
+             int type,
+             int protocol,
+             size_t sendBuffer,
+             size_t recvBuffer);
+
+  SocketFile* asSocket() override { return this; }
+
+  virtual int bind(const sockaddr* addr, socklen_t len) = 0;
+  // `nonblock`: the descriptor is O_NONBLOCK.
+  virtual int connect(const sockaddr* addr, socklen_t len, bool nonblock) = 0;
+  // There are no inbound connections in a browser.
+  virtual int listen(int backlog) { return -EOPNOTSUPP; }
+  virtual int shutdown(int how) = 0;
+  virtual int getsockname(sockaddr* addr, socklen_t* len) = 0;
+  virtual int getpeername(sockaddr* addr, socklen_t* len) = 0;
+
+  int getsockopt(int level, int name, void* value, socklen_t* len);
+  int setsockopt(int level, int name, const void* value, socklen_t len);
+
+  // getsockopt/setsockopt's view of the buffer sizes (SO_SNDBUF, SO_RCVBUF:
+  // what was set, doubled as on Linux), which subclasses use as their bounds.
+  size_t sendBufferSize() const { return sendBuffer.load(); }
+  size_t recvBufferSize() const { return recvBuffer.load(); }
+
+protected:
+  // SO_RCVTIMEO / SO_SNDTIMEO in milliseconds, or -1 for none.
+  int recvTimeoutMs() const { return recvTimeout.load(); }
+  int sendTimeoutMs() const { return sendTimeout.load(); }
+
+  // An int-sized option's stored value, or `otherwise` if never set.
+  int intOption(int level, int name, int otherwise);
+  // SO_LINGER.
+  bool lingerOption(struct linger* out);
+
+  // SO_ERROR: the pending error, cleared by reading it.
+  virtual int takeError() { return 0; }
+  // Whether options at this level apply (SOL_SOCKET always does).
+  virtual bool supportsLevel(int level) = 0;
+  // SO_SNDBUF or SO_RCVBUF changed.
+  virtual void buffersChanged() {}
+
+private:
+  std::atomic<size_t> sendBuffer;
+  std::atomic<size_t> recvBuffer;
+  std::atomic<int> recvTimeout{-1};
+  std::atomic<int> sendTimeout{-1};
+
+  // Options with no effect here, stored so getsockopt returns what was set.
+  // Guarded by optionsMutex, which is a leaf lock.
+  struct Stored {
+    int level;
+    int name;
+    socklen_t len;
+    unsigned char value[32];
+  };
+  std::mutex optionsMutex;
+  std::vector<Stored> stored;
+};
+
+// Copies a socket address out to a caller's buffer with accept()/getsockname()
+// semantics: truncates to *len, then sets *len to the full size.
+int copySockaddrOut(const void* addr, socklen_t size, sockaddr* out, socklen_t* len);
+
+// socketpair(AF_UNIX, SOCK_STREAM): two connected in-memory sockets.
+int createSocketPair(int type, std::shared_ptr<SocketFile> ends[2]);
+
