     try {
-      size = await accessHandle.getSize();
+      size = accessHandle.getSize();
     } catch {
       size = -{{{ cDefs.EIO }}};
     }
     {{{ makeSetValue('sizePtr', 0, 'size', 'i64') }}};
+    (globalThis.__opfsStats ||= {reads:0,readBytes:0,writes:0,writeBytes:0,sizes:0,flushes:0,opens:0}).sizes++;
