-            ctx.ctx, state.getBlobID(), buf, len, offset, &nread);
-        });
-        break;
-      case OpenState::None:
-      default:
-        WASMFS_UNREACHABLE("Unexpected open state");
-    }
-    return nread;
+    return readDirect(buf, len, offset);
   }
 
   ssize_t write(const uint8_t* buf, size_t len, off_t offset) override {
     assert(state.getKind() == OpenState::Access);
+    // Drop before the write, not after: the write can fail partway and leave the file changed regardless, and a
+    // cache that survives a failed write is the worst of both.
+    dropCache();
