+// READ-AHEAD CACHE
+//
+// Every read, write, getSize and flush below is a BLOCKING cross-thread round trip: the OPFS worker sits in
+// emscripten_exit_with_live_runtime(), so the calling thread enqueues work, waits for that worker to be woken
+// (postMessage relayed via the main thread, or the WasmFS heartbeat poll in library_wasmfs.js), and blocks until
+// it completes. Per-op latency can be attacked separately; the op COUNT is the multiplier, and it was measured
+// rather than guessed. Instrumenting library_wasmfs_opfs.js over one full Minecraft run gave, reproducibly to
+// within 4 calls across four runs:
+//
+//   reads = 98304   readMB = 110.7   (~1.15 KB average)   getSize = 17660   writes = 13
+//
+// ~116,000 blocking round trips to move 110 MB. Buffering the READS to cut that count was tried and reverted --
+// see the note on read() below for the numbers. What remains is the getSize memo, which removed 17,616 of those
+// round trips on its own.
+//
+// This cost is INVISIBLE to a CPU profile: task-clock samples only on-CPU time and a thread waiting on the proxy
+// is off-CPU, which is why it hid for so long while showing up as a 3x spread in world-load wall time.
+//
+// Correctness rests on two properties:
+//  * WASMFS serialises per-file access -- File holds a std::recursive_mutex and every read/write/getSize goes
+//    through File::locked() -- so the memo needs no lock of its own.
+//  * This backend is the only writer, and the memo is dropped on every write, setSize and close, so a stale size
+//    cannot outlive a modification made through it. It would NOT be safe against a writer outside this process,
+//    which the exclusive access handle already precludes.
+
 class OPFSFile : public DataFile {
 public:
   Worker& proxy;
@@ -166,7 +194,43 @@
   }
 
 private:
+  // Memoised getSize(). -1 means unknown. Worth its own field because getSize was 18% of all measured
+  // operations -- WASMFS asks for the size on llseek and stat, so a caller seeking through a file triggers it
+  // constantly -- and unlike the reverted read cache it hits essentially always: 2,991 -> 44 calls.
+  off_t cachedSize = -1;
+
+  void dropCache() { cachedSize = -1; }
+
+  // The uncached read, shared by read() and the cache fill.
+  ssize_t readDirect(uint8_t* buf, size_t len, off_t offset) {
+    // TODO: use an i64 here.
+    int32_t nread;
+    switch (state.getKind()) {
+      case OpenState::Access:
+        proxy([&]() {
+          nread =
+            _wasmfs_opfs_read_access(state.getAccessID(), buf, len, offset);
+        });
+        break;
+      case OpenState::Blob:
+        proxy([&](auto ctx) {
+          _wasmfs_opfs_read_blob(
+            ctx.ctx, state.getBlobID(), buf, len, offset, &nread);
+        });
+        break;
+      case OpenState::None:
+      default:
+        WASMFS_UNREACHABLE("Unexpected open state");
+    }
+    return nread;
+  }
+
   off_t getSize() override {
+    // 17,660 of the 116,000 measured round trips were this call. The size only changes through write/setSize on
+    // this same (mutex-serialised) file, both of which drop the memo.
+    if (cachedSize >= 0) {
+      return cachedSize;
+    }
     off_t size;
     switch (state.getKind()) {
       case OpenState::None:
@@ -185,10 +249,15 @@
       default:
         WASMFS_UNREACHABLE("Unexpected open state");
     }
+    // Only memoise a plausible answer; the paths above yield a negative errno on failure.
+    if (size >= 0) {
+      cachedSize = size;
+    }
     return size;
   }
 
   int setSize(off_t size) override {
+    dropCache();
     int err = 0;
     switch (state.getKind()) {
       case OpenState::Access:
@@ -219,33 +288,31 @@
 
   int open(oflags_t flags) override { return state.open(proxy, fileID, flags); }
 
-  int close() override { return state.close(proxy); }
+  int close() override {
+    // A reopen can land on a different underlying handle (Blob vs AccessHandle, or an upgrade between them), so
+    // nothing cached under the old one may carry over.
+    dropCache();
+    return state.close(proxy);
+  }
 
