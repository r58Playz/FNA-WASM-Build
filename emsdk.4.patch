   },
 
@@ -482,11 +501,13 @@
     wasmfsOPFSProxyFinish(ctx);
   },
 
+  // NOT async, for the same reason as getSize above: flush() on a SYNC access handle is synchronous.
   _wasmfs_opfs_flush_access__deps: ['$wasmfsOPFSAccessHandles', '$wasmfsOPFSProxyFinish'],
-  _wasmfs_opfs_flush_access: async function(ctx, accessID, errPtr) {
+  _wasmfs_opfs_flush_access: function(ctx, accessID, errPtr) {
     let accessHandle = wasmfsOPFSAccessHandles.get(accessID);
